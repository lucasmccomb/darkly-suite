{
  "name": "darkly-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Unified monorepo for Darkly for Gmail, Darkly for Sheets, Darkly for Docs, and Darkly Suite bundle",
  "scripts": {
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev:gmail": "pnpm --filter gmail-darkly dev",
    "dev:sheets": "pnpm --filter sheets-darkly dev",
    "dev:docs": "pnpm --filter docs-darkly dev",
    "dev:suite": "pnpm --filter darkly-suite-ext dev",
    "dev:landing": "pnpm --filter @darkly/landing-suite dev",
    "build:gmail": "pnpm --filter gmail-darkly build",
    "build:sheets": "pnpm --filter sheets-darkly build",
    "build:docs": "pnpm --filter docs-darkly build",
    "build:suite": "pnpm --filter darkly-suite-ext build",
    "build:landing": "pnpm --filter @darkly/landing-suite build",
    "clean": "pnpm -r exec -- rm -rf dist"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2"
  }
}

      siteng__generic_engine = component "Generic dark mode engine (@darkly/site-generic)" {
        technology "TypeScript, CSS filters, adoptedStyleSheets"
        summary "GenericDarkMode class behind Browse Darkly: instant invert(0.93) hue-rotate(180deg) filter, media re-inversion, atomic swap to computed overrides."
        description '''
          The any-website engine that extends the product beyond Google Workspace to the Dark Reader / Night Eye audience in the brief. Unlike the Workspace packages it does not implement `SitePlugin`; it owns its own lifecycle (`enable`/`disable`/`toggle`/`isEnabled`) and is driven directly by the Browse Darkly content script. `enableFilter()` injects a style element applying `filter: invert(0.93) hue-rotate(180deg)` to `html` with a re-inversion rule for `img, video, canvas, svg, picture, embed, object, iframe` and inline background images — the same filter thesis as the Workspace CSS, tuned to 0.93 to soften pure-white flip. `replaceWithOverrides(css)` injects the accurate override stylesheet *before* removing the filter (an atomic swap that avoids a flash of unstyled content), and `attemptSmartDarkMode()` sequences instant-filter, DOM-ready wait, CSS-variable fast path, then swap-or-keep-filter. `breakage-handlers.ts` catalogues the top inversion artefacts (images, video, canvas, and further handlers) as selector+CSS pairs generated into a style tag, and `stylesheet-injector.ts` prefers `document.adoptedStyleSheets` with a style-element fallback for zero-DOM-mutation injection. The package's `index.ts` is a wide public surface exporting every subsystem below.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/generic-engine.ts#L20-L147 "source"
        siteng__generic_breakage = file "breakage-handlers.ts" {
          technology "TypeScript, CSS"
          summary "Named selector+CSS handlers for the most common filter-inversion artefacts, emitted as injectable CSS."
          description '''
            Encodes hard-won fixes for the failure mode that makes naive inversion look broken, because 'polished' rather than 'inverted' is the differentiator the brief sells against Dark Reader.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/breakage-handlers.ts#L1-L40 "source"
        }
        siteng__generic_engine_file = file "generic-engine.ts" {
          technology "TypeScript"
          summary "GenericDarkMode: filter enable/disable, atomic override swap, attemptSmartDarkMode() pipeline entry."
          description '''
            The class Browse Darkly instantiates per page, because the brief's promise of dark mode on *every other website* needs an instant zero-knowledge fallback that can later upgrade itself to accurate overrides.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/generic-engine.ts "source"
        }
        siteng__generic_index = file "index.ts — public surface" {
          technology "TypeScript"
          summary "Barrel exporting engine, detection, colour transform, cache, shadow DOM, SPA proxy, worker pipeline, analysis, sanitizer, privacy reporter."
          description '''
            The one file that shows the intended full architecture of the generic engine, because it reveals a large built-but-not-yet-wired capability set behind the shipped filter path.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/index.ts#L1-L109 "source"
        }
      }
      siteng__generic_detection = component "Smart site detection and analysis" {
        technology "TypeScript, computed-style sampling"
        summary "Decides whether a site is already dark or should be skipped: bootstrap domain list, meta/class/luminance heuristics, and CSS complexity classification."
        description '''
          Stops Browse Darkly from double-darkening sites that already ship a dark theme, which is the single most visible correctness failure for the general-browser audience in the brief. `isDarkSite()` checks four signals in order: membership in `DARK_SITES` (a ~35-domain bootstrap list covering GitHub, X, Discord, Netflix, Notion, Slack, YouTube and similar, with subdomain roll-up via `isKnownDarkSite`), a `meta[name="color-scheme"]` that says dark and not light, dark-mode class patterns on html/body, and finally sampled body background luminance below 0.3. `analysis/native-dark-detection.ts` answers the related but distinct question of whether the site is *currently rendering* dark (returning average luminance and which method decided), while `analysis/dark-mode-detection.ts` analyses whether a site *supports* dark mode at all. `analysis/complexity-classifier.ts` counts stylesheets, rules, inline styles, shadow roots and CSS custom properties to classify a page simple/moderate/complex and recommend `css-vars`, `full-processing` or `filter-only` — the routing decision that lets the engine spend effort proportionally. Only `isDarkSite` is currently imported by the Browse Darkly content script; the analysis modules are exported but not yet consumed elsewhere.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/dark-site-detector.ts#L11-L46 "source"
        siteng__generic_complexity = file "analysis/complexity-classifier.ts" {
          technology "TypeScript"
          summary "Counts stylesheets, rules, inline styles, shadow roots and CSS vars; returns simple/moderate/complex plus a recommended strategy."
          description '''
            Routing brain for the override pipeline, because spending full CSS processing on a site that a :root variable rewrite would fix wastes the page-load budget the brief's polish promise depends on.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/analysis/complexity-classifier.ts#L1-L40 "source"
        }
        siteng__generic_dark_sites = file "dark-sites.ts" {
          technology "TypeScript"
          summary "Static bootstrap set of ~35 natively-dark domains with parent-domain matching for subdomains."
          description '''
            Zero-cost first check before any DOM sampling, because on high-traffic destinations (GitHub, X, Netflix, Slack) the correct behaviour is known up front and should not wait for luminance heuristics.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/dark-sites.ts#L1-L62 "source"
        }
        siteng__generic_detector_file = file "dark-site-detector.ts" {
          technology "TypeScript"
          summary "isDarkSite(): known-list, color-scheme meta, dark class patterns, then body luminance below 0.3."
          description '''
            The guard Browse Darkly calls before enabling anything, because darkening an already-dark site produces an unreadable page and is the fastest way to lose the general-browser user.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/dark-site-detector.ts "source"
        }
      }
      siteng__generic_css_pipeline = component "Generic CSS override pipeline" {
        technology "TypeScript, IndexedDB, IntersectionObserver, CSSOM"
        summary "Colour transform engine, CSS-variable fast path, per-rule stylesheet processor, IndexedDB cache and cached/vars/full/filter strategy selection."
        description '''
          The 'accurate overrides' half of Browse Darkly that is meant to replace the instant filter. `color-transform.ts` parses hex/rgb/hsl/named CSS colours into RGB, converts to HSL and applies context-aware lightness transforms keyed by `'background' | 'foreground' | 'border'`. `css-var-fast-path.ts` scans `:root` computed custom properties, keeps the ones holding colours, transforms them and emits a single override style element — the cheapest possible full-site theming for modern variable-driven sites. `worker/css-processor.ts` is the heavier path: it walks stylesheet rules, classifies each declaration's colour context, and generates override CSS (structured to be delegable to a Web Worker). `override-pipeline.ts` sequences the strategies — IndexedDB cache hit, then CSS-var fast path, then full processing, then filter-only — while the GPU filter provides instant visual feedback, and hashes all reachable stylesheet text (falling back to href fingerprints for CORS-blocked sheets) as the cache key. `css-cache.ts` persists `{domain, cssHash, css, timestamp}` in an IndexedDB store with a 7-day max age and an FNV-1a hash, so a repeat visit is a cache read rather than a re-computation. Supporting modules cover SPA stylesheet mutation interception, viewport-prioritised incremental processing and shadow-DOM injection.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/override-pipeline.ts#L1-L50 "source"
        siteng__generic_color_transform = file "color-transform.ts" {
          technology "TypeScript"
          summary "CSS colour parsing (hex/rgb/hsl/named), RGB-HSL conversion and context-aware lightness transforms for bg/fg/border."
          description '''
            Largest file in the area and the basis for non-filter theming, because computing a per-colour dark equivalent is what lets Browse Darkly keep brand hues instead of hue-rotating them wholesale.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/color-transform.ts "source"
        }
        siteng__generic_css_cache = file "css-cache.ts" {
          technology "IndexedDB"
          summary "IndexedDB store 'browse-darkly-cache' keyed by domain, 7-day expiry, FNV-1a content hash, expired-entry cleanup."
          description '''
            Per-site memory for computed themes, because recomputing a large site's override CSS on every visit would blow the page-load budget that separates a polished product from a laggy one.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/css-cache.ts#L1-L45 "source"
        }
        siteng__generic_override_pipeline_file = file "override-pipeline.ts" {
          technology "TypeScript"
          summary "executeOverridePipeline: cached, css-vars, full-processing, filter-only — with timing and CORS-safe CSS fingerprinting."
          description '''
            The documented decision flow for how Browse Darkly upgrades from instant filter to accurate CSS, because the brief's quality claim on arbitrary sites rests on picking the cheapest strategy that still looks right.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/override-pipeline.ts "source"
        }
        siteng__generic_var_fast_path = file "css-var-fast-path.ts" {
          technology "TypeScript"
          summary "Scans :root custom properties for colour values, transforms them, emits one override stylesheet."
          description '''
            The only override strategy currently reachable at runtime (via attemptSmartDarkMode), because on CSS-variable-driven sites it themes the whole page with zero per-rule work and no visible flash.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/css-var-fast-path.ts#L1-L40 "source"
        }
        siteng__generic_worker_processor = file "worker/css-processor.ts" {
          technology "TypeScript, CSSOM"
          summary "Walks stylesheet rules, classifies declarations as background/foreground/border colour, emits override CSS; worker-delegable."
          description '''
            The full-processing fallback for sites that do not expose colour variables, because those are exactly the legacy sites where filter inversion looks worst and hand overrides do not scale.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/worker/css-processor.ts#L1-L40 "source"
        }
      }
      siteng__generic_runtime_adapters = component "Dynamic-page adapters: SPA, viewport, shadow DOM" {
        technology "TypeScript, CSSOM monkey-patching, IntersectionObserver, Shadow DOM, CSS @layer"
        summary "Stylesheet-mutation proxy for SPAs, IntersectionObserver-driven above-fold-first processing, and a shadow-DOM discovery/injection/layers/perf toolkit."
        description '''
          Handles the three ways a modern page defeats a one-shot stylesheet pass, which is what 'works on every other website' in the brief actually costs. `spa-support.ts` monkey-patches `CSSStyleSheet.prototype.insertRule/deleteRule/replace/replaceSync`, batching changed sheets through a `setTimeout(0)` queue so route changes and runtime CSS-in-JS trigger reprocessing exactly once rather than per rule (and it deliberately settles the `replace()` promise both ways so no rejection floats). `viewport-processor.ts` processes currently visible elements immediately then registers an `IntersectionObserver` with a 200px root margin, tracking done elements in a `WeakSet`, so above-fold content darkens first and below-fold work happens at background priority. The `shadow-dom/` directory covers open and closed root access, recursive root discovery, `@layer`-ordered CSS wrapping, custom-property inheritance into roots, and a perf optimiser — needed because web-component-heavy sites hide most of their styling from document-level injection. These modules are exported from the package index but are not yet imported by the Browse Darkly content script.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/spa-support.ts#L11-L115 "source"
        siteng__generic_shadow_dom = file "shadow-dom/shadow-discovery.ts" {
          technology "TypeScript"
          summary "Recursive shadow-root discovery feeding the shadow style injector, CSS-layer wrapper and custom-property inheritance helpers."
          description '''
            Reaches styling that document-level injection cannot touch, because component-heavy sites would otherwise show light islands inside an otherwise dark page.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/shadow-dom/shadow-discovery.ts "source"
        }
        siteng__generic_spa_proxy = file "spa-support.ts" {
          technology "TypeScript"
          summary "StylesheetProxy intercepting CSSStyleSheet mutation methods with batched change callbacks and full restore on stop()."
          description '''
            Detects runtime stylesheet changes that a MutationObserver cannot see, because single-page apps rewrite CSSOM directly and a theme that only applies at load would silently regress on navigation.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/spa-support.ts "source"
        }
        siteng__generic_viewport = file "viewport-processor.ts" {
          technology "TypeScript"
          summary "Above-fold-first processing with IntersectionObserver (200px rootMargin) and WeakSet dedupe."
          description '''
            Prioritises what the reader can actually see, because perceived speed on first paint is the difference between a dark mode that feels polished and one that feels like a filter being bolted on.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/viewport-processor.ts#L1-L40 "source"
        }
      }
      siteng__generic_site_fixes = component "Site-fix directives, sanitizer and privacy reporter" {
        technology "TypeScript, WebCrypto SHA-256, chrome.storage.local"
        summary "Text DSL (CSS/HIDE/INVERT/VAR/SKIP) for per-site corrections, a CSS sanitizer for externally sourced fixes, and SHA-256-hashed domain issue reports."
        description '''
          The escape hatch and feedback loop around the generic engine. `fix-parser.ts` defines a line-oriented directive format — `CSS selector { ... }`, `HIDE selector`, `INVERT selector`, `VAR prop value`, `SKIP` (domain is already dark), with `#` comments — plus `parseFixBundle` for shipping many domains' fixes together; `fix-applier.ts` materialises each directive as a `style` element tagged `data-darkly-fix="true"` and returns a cleanup function, with INVERT emitting exactly the brief's `invert(1) hue-rotate(180deg)`. `security/css-sanitizer.ts` guards that path: it rejects payloads over 1 MB and strips `javascript:` and `data:text/html` urls, `expression()`, `-moz-binding`, `behavior:` and `@import`, because fixes are described as arriving from external bundles/CDN and injected CSS is an attack surface. `privacy/domain-reporter.ts` lets a user report a site as broken / already-dark / partial, but SHA-256-hashes the domain via WebCrypto before storing it under `bd_domain_reports` in `chrome.storage.local`, so the operator can learn which sites break without ever holding a user's browsing history — a defensible privacy posture for a paid consumer extension. No other package currently imports these modules.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/fix-parser.ts#L1-L50 "source"
        siteng__generic_fix_applier = file "fix-applier.ts" {
          technology "TypeScript"
          summary "Turns parsed directives into tagged style elements (hide/invert/var/css) and returns a cleanup closure."
          description '''
            The runtime half of the fix DSL, because directives must be reversible when the user toggles dark mode off — the brief's mutex and toggle semantics require a clean teardown.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/fix-applier.ts#L1-L57 "source"
        }
        siteng__generic_fix_parser = file "fix-parser.ts" {
          technology "TypeScript"
          summary "Directive DSL and typed AST: CssDirective, HideDirective, InvertDirective, VarDirective, SkipDirective, SiteFix bundles."
          description '''
            Defines how per-site corrections are authored and distributed, because a generic inversion engine still needs a cheap, data-shaped way to patch the long tail without shipping a new extension build.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/fix-parser.ts "source"
        }
        siteng__generic_privacy_reporter = file "privacy/domain-reporter.ts" {
          technology "WebCrypto, chrome.storage.local"
          summary "Hashes domains with SHA-256 before storing broken/already-dark/partial reports in chrome.storage.local."
          description '''
            Gives the solo operator a breakage signal without collecting browsing history, because Browse Darkly runs on every site and any plaintext domain telemetry would be a privacy and CWS-review liability.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/privacy/domain-reporter.ts#L1-L75 "source"
        }
        siteng__generic_sanitizer = file "security/css-sanitizer.ts" {
          technology "TypeScript"
          summary "Strips javascript:/data:text/html urls, expression(), -moz-binding, behavior:, @import; enforces a 1 MB cap."
          description '''
            Defends the externally-sourced-fix channel, because a commercial extension that injects remotely fetched CSS into every site the user visits cannot afford an unsanitised path.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-generic/src/security/css-sanitizer.ts#L1-L40 "source"
        }
      }
    }

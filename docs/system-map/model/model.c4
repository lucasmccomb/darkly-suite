      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/deploy-landing.yml#L194-L225 "source"
      link https://docsdarkly.com "site"
      lmkt__docs_site_app = component "docsdarkly.com SPA (landing-docs)" {
        technology "Vite 7, React 19, react-router-dom 7, TypeScript"
        summary "Vite+React SPA for docsdarkly.com selling Kix-canvas dark mode; same five routes and shared components, Docs-specific config and gallery."
        description '''
          Marketing domain for **Darkly for Docs**. Uses the identical five-route shell and shared Hero/Features/Pricing/FAQ/SetupGuide components as the Gmail and Sheets sites because the suite's marketing surface is one component library skinned four ways; the Docs-specific pitch (Kix editor canvas theming, ruler/toolbar/menu styling, "Preserve Page Colors" toggle, in-Docs settings panel) lives in `src/config.ts` and `HomePage`'s feature items.
          
          `STORE_URL` is still `PLACEHOLDER_DOCS_ID`, so the nav CTA drives to on-page pricing; checkout goes to `https://darklysuite.com/api/checkout` and restore to `/api/auth/start`, keeping one Stripe account and one D1 licence database behind all four domains. `useExtensionToken('docs')` reads the chrome.storage.sync UUID out of an already-installed extension before checkout so the purchase binds to the existing token.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-docs/src/config.ts#L1-L40 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-docs/src/pages/HomePage.tsx#L1-L60 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-docs/src/App.tsx "source"
        lmkt__docs_config = file "landing-docs config.ts" {
          technology "TypeScript"
          summary "Docs site copy: placeholder CWS id, centralised checkout/auth URLs, Kix-canvas feature list, FAQ, and the 3 pricing tiers."
          description '''
            Carries the whole Docs-domain identity (nav, footer, support contact, feature bullets naming Kix canvas theming and Preserve Page Colors) because every other file in the package is shared-component glue; the pricing tiers mirror the other products so the 5x3 Stripe matrix stays uniform across domains.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-docs/src/config.ts "source"
        }
        lmkt__docs_delivery_config = file "landing-docs Pages delivery config" {
          technology "wrangler.toml, Cloudflare Pages _headers"
          summary "wrangler.toml (project docs-darkly), strict CSP _headers, Docs-specific SEO meta in index.html."
          description '''
            Makes docsdarkly.com an independently deployable Pages project because each product domain must be separately SEO-addressable and separately releasable; `_headers` repeats the suite CSP baseline that permits only Stripe checkout/billing as form targets, keeping payment redirects working under a `default-src 'self'` policy.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-docs/wrangler.toml "source"
        }
        lmkt__docs_screenshot_gallery = file "landing-docs screenshot gallery assets" {
          technology "JPEG/PNG assets"
          summary "Harness-generated Docs screenshots and setup imagery under public/images."
          description '''
            Written directly by `packages/screenshot-harness/capture-docs-landing.mjs`, which resolves `../landing-docs/public/images/screenshots` and the setup directory as its final output directories, so the Docs domain's gallery stays in sync with the shipping extension instead of drifting.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-docs/public/images/screenshots/split-view.jpg "source"
        }
      }
    }
    web_gmaildarkly = container "gmaildarkly.com (Gmail marketing site)" {
      technology "Vite 7, React 19, Cloudflare Pages"
      summary "Static Vite + React 19 marketing site for the Gmail extension, deployed to Cloudflare Pages project gmail-darkly. No backend."
      description '''
        Per-product marketing front door for Darkly for Gmail, built from the shared Hero/Features/Pricing/FAQ/ScreenshotShowcase components in `@darkly/landing-shared`.
        
        It exists as its own deployment with no Functions directory **because each extension is sold as a separate CWS listing that needs its own SEO-addressable domain and screenshot gallery, while checkout is deliberately centralised on darklysuite.com** - the Gmail extension's `landing-bridge.js` content script runs on both this domain and darklysuite.com so a licence bought anywhere reaches the installed extension.
      '''
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/package.json "source"
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/wrangler.toml "source"
      link https://gmaildarkly.com "site"
      lmkt__gmail_site_app = component "gmaildarkly.com SPA (landing-gmail)" {
        technology "Vite 7, React 19, react-router-dom 7, TypeScript, lucide-react"
        summary "Vite+React SPA for gmaildarkly.com: home/privacy/setup/subscribe/success routes composed from @darkly/landing-shared, driven by a local config.ts."
        description '''
          The per-product marketing site for **Darkly for Gmail**, the one extension already published to the Chrome Web Store (1.0.2). Exists as its own package because the vision calls for each product to own a separate SEO-addressable domain rather than a single suite page: `index.html` carries Gmail-specific title/description meta, and `src/config.ts` holds the only real CWS listing id in the repo, so the "Add to Chrome" CTA is a live install link while the sibling sites still carry placeholders.
          
          `src/App.tsx` mounts five routes (`/`, `/privacy`, `/setup`, `/subscribe`, `/success`) over `BrowserRouter`; every page is assembled from shared `Nav`/`Hero`/`Features`/`Pricing`/`FAQ`/`Footer`/`SetupGuide` components so a design change in `@darkly/landing-shared` propagates to all five domains. Site-specific data lives entirely in `config.ts`: nav/footer links, the CWS badge, an 8-item Gmail feature list, a 6-item FAQ (including the reinstall/restore-purchase answer that matches the UUID-token identity model), and `individualTiers()` at $0.99/mo, $5.99/yr, $9.99 lifetime — the 3 plans of the 5x3 Stripe price matrix.
          
          Checkout stays centralised: `HomePage` calls `useExtensionToken('gmail')` to read the licence token out of the installed extension via the landing-bridge, then `buildCheckoutUrl` against `https://darklysuite.com/api/checkout`; `SubscribePage` points at `https://darklysuite.com/api/auth/start` for restore-purchase sign-in. `SuccessPage` calls `useCheckoutComplete('gmail')` to hand the licence back to the extension and offers a "Return to Gmail" link plus a setup deep-link at `/setup#step-4`. Hero and feature galleries reference three captured screenshots under `public/images/screenshots/`.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/src/config.ts#L1-L32 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/src/pages/HomePage.tsx#L19-L58 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/src/App.tsx#L9-L22 "source"
        lmkt__gmail_config = file "landing-gmail config.ts" {
          technology "TypeScript"
          summary "Single source of Gmail-site copy: real CWS listing URL, centralised checkout/auth endpoints, feature list, FAQ, and the 3 pricing tiers."
          description '''
            Holds every value that differentiates gmaildarkly.com from its three siblings because the four sites share identical React components and differ only by config: `STORE_URL` (the only non-placeholder Chrome Web Store id in the four packages, matching the published Gmail listing), `CHECKOUT_API_URL`/`AUTH_API_URL` both pointing at darklysuite.com so payment stays on one Stripe account, and `individualTiers()` returning the Monthly/Yearly/Lifetime rows of the 5x3 price matrix.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/src/config.ts#L1-L101 "source"
        }
        lmkt__gmail_delivery_config = file "landing-gmail Pages delivery config" {
          technology "wrangler.toml, Cloudflare Pages _headers"
          summary "wrangler.toml (Pages project darkly-gmail, output dist), _headers CSP/HSTS, and Gmail-specific SEO meta in index.html."
          description '''
            Ships the site as a static Cloudflare Pages project because all five Darkly domains deploy to Pages: `wrangler.toml` declares `pages_build_output_dir = "dist"`, `public/_headers` locks the site down with a strict CSP whose only `form-action` exceptions are checkout.stripe.com and billing.stripe.com (matching the centralised Stripe checkout hop), and `index.html` carries the Gmail-specific title/description that makes this a distinct SEO surface from sheetsdarkly/docsdarkly.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/wrangler.toml "source"
        }
        lmkt__gmail_screenshot_gallery = file "landing-gmail screenshot gallery assets" {
          technology "JPEG assets"
          summary "Three product screenshots (split-view, panel-open-dark, panel-views) wired into Hero and Features by HomePage."
          description '''
            Static JPEGs served from `public/images/screenshots/` and referenced by `HomePage`'s `heroScreenshots`/`featureScreenshots` arrays; they exist because each marketing domain carries its own gallery proving the dark theme inside the real product surface (split light/dark Gmail, settings panel open, and the four theme modes Schedule/Default/Sunrise-Sunset/System).
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/public/images/screenshots/split-view.jpg "source"
        }
        lmkt__gmail_setup_page = file "landing-gmail SetupPage" {
          technology "React"
          summary "Post-install walkthrough rendering shared SetupGuide scoped to products: ['gmail'], with matching setup screenshots in public/images/setup."
          description '''
            Renders the shared `SetupGuide` locked to `activeTab="gmail"` and `products={['gmail']}` because a single-product domain must not show the other four extensions' onboarding; SuccessPage deep-links here (`/setup#step-4`) so a buyer who already installed the extension lands on the licence-activation step rather than the download step.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/src/pages/SetupPage.tsx#L1-L33 "source"
        }
      }
    }
    web_sheetsdarkly = container "sheetsdarkly.com (Sheets marketing site)" {
      technology "Vite 7, React 19, Cloudflare Pages"
      summary "Static Vite + React 19 marketing site for the Sheets extension, deployed to Cloudflare Pages project sheets-darkly."
      description '''
        Marketing-only deployment for Darkly for Sheets, sharing the same component library as the other landing sites.
        
        It is a distinct Pages project with its own change-detected CI job **because the Sheets extension is a separately licensed SKU whose Preserve Grid Colors story and spreadsheet screenshots do not belong on the Gmail or hub pages**, and because `landing-bridge.js` in the Sheets manifest is scoped to this exact domain to receive the licence token after checkout.
      '''
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-sheets/package.json "source"
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-sheets/wrangler.toml "source"
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/deploy-landing.yml#L159-L190 "source"
      link https://sheetsdarkly.com "site"
      lmkt__sheets_site_app = component "sheetsdarkly.com SPA (landing-sheets)" {
        technology "Vite 7, React 19, react-router-dom 7, TypeScript"
        summary "Vite+React SPA for sheetsdarkly.com with grid-aware Sheets copy, screenshot gallery, and centralised checkout; CWS id still a placeholder."
        description '''
          Marketing domain for **Darkly for Sheets**, aimed at the knowledge worker who lives in spreadsheets. Structurally identical to landing-gmail (same five routes in `src/App.tsx`, same shared Hero/Features/Pricing/FAQ components) because the suite intentionally trades per-site bespoke code for one shared component library; all divergence sits in `src/config.ts` and `HomePage`'s feature items, which sell grid/cell-aware styling, formula-bar theming and the in-Sheets settings panel.
          
          `config.ts` still carries `PLACEHOLDER_SHEETS_ID` in `STORE_URL`, matching the vision's "only Gmail published" state, so the nav CTA points at `/#pricing` instead of the store. Checkout and restore both target darklysuite.com (`/api/checkout`, `/api/auth/start`), and `HomePage` calls `useExtensionToken('sheets')` so a buyer who already has the extension reuses the existing UUID token rather than minting a second licence. Hero/feature galleries read three screenshots from `public/images/screenshots/`, which the screenshot harness regenerates automatically.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-sheets/src/config.ts#L1-L40 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-sheets/src/pages/HomePage.tsx#L1-L60 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-sheets/src/App.tsx "source"
        lmkt__sheets_config = file "landing-sheets config.ts" {
          technology "TypeScript"
          summary "Sheets site copy: placeholder CWS id, darklysuite.com checkout/auth URLs, grid-aware feature list, FAQ, and the 3 pricing tiers."
          description '''
            Defines the Sheets-only surface of the shared components because the site is a config skin over @darkly/landing-shared; notable that `STORE_URL` is a `PLACEHOLDER_SHEETS_ID` placeholder, so `NAV_CTA` sends visitors to the on-page pricing block instead of the Chrome Web Store until the listing is published.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-sheets/src/config.ts "source"
        }
        lmkt__sheets_delivery_config = file "landing-sheets Pages delivery config" {
          technology "wrangler.toml, Cloudflare Pages _headers"
          summary "wrangler.toml (project darkly-sheets), strict CSP _headers, and Sheets-specific SEO meta."
          description '''
            Publishes the Sheets domain as its own Cloudflare Pages project because each product gets a separately indexable domain; `index.html` carries the Sheets-only title/description, and `_headers` applies the same CSP/HSTS/Permissions-Policy baseline as the other three sites with Stripe checkout allowed only as a `form-action` target.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-sheets/wrangler.toml "source"
        }
        lmkt__sheets_screenshot_gallery = file "landing-sheets screenshot gallery assets" {
          technology "JPEG/PNG assets"
          summary "Harness-generated Sheets screenshots (split-view, panel-views) plus setup guide images."
          description '''
            Gallery assets under `public/images/` that the screenshot harness writes directly (`capture-sheets-landing.mjs` resolves this exact directory), so marketing imagery for the Sheets domain is regenerated from the real extension rather than hand-edited.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-sheets/public/images/screenshots/split-view.jpg "source"
        }
      }
    }
    core_engine = container "Shared engine (@darkly/core)" {
      technology "TypeScript, React 18"
      description '''
        One shared package supplies the theme engine, presets, preferences, payment client, background worker, content bootstrap, injection kit, settings UI, conflict mutex and landing bridge — because every product is @darkly/core plus one site plugin, a fix here reaches all five extensions in one commit.
      '''
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/package.json "source"
      core__config_contract = component "ProductConfig / SitePlugin contract" {
        technology "TypeScript"
        summary "Foundational types every core module is parameterised by: ProductConfig (prefix, storage keys, apiBase) and the SitePlugin interface each @darkly/site-* implements."
        description '''
          The parameterisation layer that makes the maintainer-leverage promise real: **because** each product is `@darkly/core` + one `@darkly/site-*` plugin, every core module takes a `ProductConfig` carrying `prefix` (gd/sd/dd/ds/bd, the same token the build-time CSS prefix loader rewrites), `storageKey`, `tokenKey`, `proCacheKey`, `apiBase`, `siteBase`, `alarmName` and `tabUrlPattern` — so one implementation serves all five extensions with no forking. `SitePlugin` declares the host-app seams: `injectToolbarButton`, `injectSidebarIcon`, `startDomObserver`, `registerKeyboardShortcuts`, `renderProductSection`, `overrideStyles` and `getPageContext` ('editor' vs 'dashboard'). `forceColorSchemeLight` exists specifically so Docs can suppress Google's own half-finished native dark mode rather than fight it. `index.ts` is the single public barrel each extension imports from.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/config.ts#L1-L69 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/index.ts "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/context.tsx "source"
        core__config_file = file "config.ts" {
          technology "TypeScript"
          summary "ProductConfig, SitePlugin, ProductId/Plan/SiteId unions — the one type surface every other core module depends on."
          description '''
            Declares `ProductId = 'gmail'|'sheets'|'docs'|'suite'|'browse'` and `Plan = 'monthly'|'yearly'|'lifetime'`, **because** the Stripe catalogue is exactly 5 products x 3 plans = 15 prices and the same union drives checkout URLs and paywall rendering. `SitePlugin.overrideStyles` and `renderProductSection` are the hooks Sheets uses for Preserve Grid Colors and Docs for Preserve Page Colors.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/config.ts#L1-L69 "source"
        }
        core__index_barrel = file "index.ts (public barrel)" {
          technology "TypeScript"
          summary "Single entry point re-exporting theme engine, storage, payment, geo, inject and UI to the five extension packages."
          description '''
            `main`/`types` in package.json both point here, so extensions consume raw TypeScript source rather than a build artifact — **because** each of the five extension builds runs its own webpack pass with a different CSS/class prefix, a pre-compiled core bundle would have baked in the wrong prefix.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/index.ts#L1-L114 "source"
        }
      }
      core__theme_engine = component "Theme engine and mode resolution" {
        technology "TypeScript, DOM"
        summary "ThemeEngine sets prefixed data-* attributes on the html element, plus system-theme detection, schedule evaluation and a fade-to-black transition overlay."
        description '''
          The runtime that turns a chosen mode into pixels. `ThemeEngine.apply()` writes `data-{prefix}-theme="dark|light"` and `data-{prefix}-preset` on `documentElement` and sets `style.colorScheme`, **because** the product promise is attribute-driven CSS (filter inversion / variable swaps declared in stylesheets) rather than brittle per-class JS overrides — flipping one attribute repaints the whole host app. `SystemThemeDetector` wraps `matchMedia('(prefers-color-scheme: dark)')` for the *system* mode; `shouldBeDark()` evaluates the *schedule* mode including midnight-wrapping ranges (default 20:00-07:00); `createTransitionManager()` fades a full-viewport black overlay across the switch and deliberately no-ops before `init()` to avoid FOUC on first paint. `setGridPreference()` and `setPagelessMode()` are the engine-side hooks for Sheets' Preserve Grid Colors and Docs' page/pageless handling.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/engine.ts#L1-L110 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/detector.ts "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/scheduler.ts "source"
        core__engine_file = file "theme/engine.ts" {
          technology "TypeScript"
          summary "ThemeEngine class: init/apply/toggle/applyPreset plus Sheets grid and Docs pageless attribute setters."
          description '''
            Every attribute name is built from `config.prefix`, **because** a standalone extension and the Suite bundle can be installed simultaneously and must not read each other's DOM state. `applyThemeAttribute` forces `color-scheme: light` when `forceColorSchemeLight` is set so Google's native Docs dark mode never activates alongside ours.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/engine.ts#L61-L98 "source"
        }
        core__scheduler_file = file "theme/scheduler.ts" {
          technology "TypeScript"
          summary "shouldBeDark(startHour, endHour) with midnight-wrap handling for the schedule theme mode."
          description '''
            Seventeen lines that back one of the five advertised theme modes, **because** the common user schedule (20:00-07:00) crosses midnight and a naive range check would leave the theme light all night.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/scheduler.ts#L1-L17 "source"
        }
        core__transitions_file = file "theme/transitions.ts" {
          technology "TypeScript"
          summary "Fade-to-black overlay manager wrapping every theme change; no-ops until init() to avoid first-paint flash."
          description '''
            Provides the 'polished' half of the polished-dark-mode promise, **because** an instantaneous invert of a full Gmail inbox reads as a flash; a 200ms fade with a 150ms settle hides the repaint.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/transitions.ts#L1-L67 "source"
        }
      }
      core__theme_presets = component "Colour presets and canonical CSS variables" {
        technology "CSS custom properties"
        summary "Six presets (Default, Nord, Solarized, Monokai, Catppuccin, Rose Pine) as --darkly-* custom property sets, plus the shared base theme and settings-panel stylesheets."
        description '''
          Implements the six-colour-preset selling point. Each preset is a map of 14 `--darkly-*` custom properties applied inline to `documentElement` by `ThemeEngine.applyPresetVariables`, **because** swapping variables re-skins every surface at once instead of maintaining per-app class overrides. All names use the canonical `darkly-` token that the build-time webpack prefix loader rewrites to `gd-`/`sd-`/`dd-`/`ds-`/`bd-` per extension — the header comment in `themes.css` states this contract explicitly, and it is why source files never hardcode a product prefix. `settings-panel.css` (~1250 lines) is the shared skin for the in-app settings surface that lives inside Gmail's InboxSDK sidebar and the Sheets/Docs toolbar dropdowns.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/presets.ts#L1-L122 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/styles/themes.css "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/styles/index.css "source"
        core__presets_file = file "theme/presets.ts" {
          technology "TypeScript"
          summary "PRESETS record and DEFAULT_DARK_VARIABLES; getPreset() returns null for 'default' so the engine strips inline variables."
          description '''
            Holds the exact palettes marketed on the sites, **because** preset selection is a paid differentiator and the values must be identical across all five products; variable names carry the canonical `--darkly-` prefix rewritten at build time.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/presets.ts#L9-L27 "source"
        }
        core__themes_css_file = file "styles/themes.css" {
          technology "CSS"
          summary "Base light/dark variable sets keyed off [data-darkly-theme], the attribute ThemeEngine writes."
          description '''
            The CSS half of the attribute-driven design, **because** shipping theme CSS in the manifest means a single attribute flip unlocks dark mode — a fact the payment gating comments in `gates.ts` and `content.ts` explicitly account for when deciding where to gate Pro.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/styles/themes.css#L1-L45 "source"
        }
      }
      core__preferences_store = component "Preferences store (chrome.storage.sync)" {
        technology "TypeScript, chrome.storage.sync"
        summary "Namespaced, race-safe preferences manager over chrome.storage.sync with defaults, change subscription and a serialised save queue."
        description '''
          Persists the user's mode, preset, schedule and sunrise/sunset config under `config.storageKey`, **because** a knowledge worker expects the same dark theme on every machine they sign into and `chrome.storage.sync` gives cross-device propagation for free. `BaseUserPreferences.mode` is the canonical union of the five advertised theme modes (`light | dark | system | schedule | sunrise-sunset`) and `PresetName` the six presets. Saves are queued through a promise chain so rapid toggling cannot cause a read-modify-write loss, and the queue self-heals on rejection **because** `chrome.storage.sync` enforces MAX_WRITE_OPERATIONS_PER_MINUTE and one unhandled rejection would otherwise silently kill every later save. `onChange` filters to the sync area and this product's key only, which is what keeps a standalone extension and the bundle from reacting to each other's writes.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/storage/preferences.ts#L1-L61 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/storage/types.ts "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/storage/__tests__/preferences.test.ts "source"
        core__prefs_manager_file = file "storage/preferences.ts" {
          technology "TypeScript"
          summary "createPreferencesManager(config) — load/save/onChange with a serialised save queue that survives quota rejections."
          description '''
            The save-queue recovery comment documents a real failure mode, **because** the settings UI writes on every slider drag and toggle click; without recovery a single quota error would freeze preferences for the rest of the session.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/storage/preferences.ts#L22-L41 "source"
        }
        core__prefs_types_file = file "storage/types.ts" {
          technology "TypeScript"
          summary "ThemeMode / PresetName unions, ScheduleConfig, SunriseSunsetConfig and DEFAULT_PREFERENCES."
          description '''
            Single source of truth for the five modes and six presets named in the product pitch, **because** the settings UI, background scheduler and content script all branch on these exact strings.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/storage/types.ts#L1-L43 "source"
        }
      }
      core__payment_client = component "Licence client, Pro gating and checkout poller" {
        technology "TypeScript, fetch, chrome.storage, chrome.alarms"
        summary "UUID token identity in chrome.storage.sync, cached /status/{token} licence checks, checkout/restore/portal URL launching, and a staggered post-checkout poller."
        description '''
          The whole monetisation client. `getToken()` mints a v4 UUID via `crypto.getRandomValues` and stores it under `config.tokenKey` in `chrome.storage.sync`, **because** identity in this product is an anonymous device-synced token rather than an account — no login stands between install and purchase. `isPro()` GETs `${apiBase}/status/{token}?product={productId}` and caches only *paid* results for 30 minutes; unpaid always re-checks, **because** a user who has just paid must see Pro unlock on the very next page load. Checkout, restore and Stripe portal flows all go through `${apiBase}/auth/start` and `${apiBase}/portal` with the token and product as query params, dispatched to the background worker as `openTab` messages. `gates.ts::gateProAction` wraps Pro-only handlers so a blocked keyboard shortcut opens settings rather than doing nothing — its comment notes gating must happen at the UI seam, not inside `ThemeEngine`, **because** theme CSS ships in the manifest so setting an attribute alone unlocks dark mode. `checkout-poller.ts` polls in three staggered phases (5s for 2min, 10s to 5min, plus a 30s `chrome.alarms` net for a full hour) **because** MV3 can kill the service worker mid-checkout and the alarm survives that.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/payment/client.ts#L1-L187 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/payment/gates.ts "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/payment/checkout-poller.ts "source"
        core__checkout_poller_file = file "payment/checkout-poller.ts" {
          technology "TypeScript, chrome.alarms"
          summary "Three-phase post-checkout polling (setTimeout fast phases + chrome.alarms safety net) persisted in chrome.storage.session."
          description '''
            Detects licence activation without the user reloading anything, **because** Stripe checkout happens in a separate tab on darklysuite.com and the extension has no webhook path back into the browser.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/payment/checkout-poller.ts#L1-L118 "source"
        }
        core__payment_client_file = file "payment/client.ts" {
          technology "TypeScript"
          summary "createPaymentClient: token mint/read, cached status query, price fetch, checkout / restore / manage-subscription launchers."
          description '''
            Calls `${apiBase}/status/{token}?product=...` and stores the returned `paid`, `plan`, `subscriptionStatus`, `cancelAt` and the three-tier `prices` in `chrome.storage.local`, **because** the paywall renders live Stripe pricing and a Suite licence must be able to answer any single-product query (the bundle upsell).
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/payment/client.ts#L90-L133 "source"
        }
        core__payment_gates_file = file "payment/gates.ts" {
          technology "TypeScript"
          summary "isPro / canUseFeature / gateProAction — the single seam where free users are routed to the paywall."
          description '''
            `gateProAction(proStatus, action, onBlocked)` deliberately sends blocked users to settings, **because** a Pro-only shortcut that silently no-ops reads as a bug rather than as a locked feature, and settings is where the paywall lives.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/payment/gates.ts#L13-L36 "source"
        }
      }
      core__sun_scheduler = component "Geolocation and sunrise/sunset times" {
        technology "TypeScript, chrome.offscreen, sunrise-sunset.org"
        summary "Privacy-rounded coordinate lookup against sunrise-sunset.org with a 24h per-product cache, fed by an MV3 offscreen document for geolocation."
        description '''
          Backs the sunrise/sunset theme mode. `getSunTimes()` rounds latitude and longitude to 1 decimal (~11 km) *before* any network request or cache write, **because** the Chrome Web Store privacy declaration promises only approximate location leaves the device and full-precision coordinates must never reach a third party. Results cache in `chrome.storage.local` for 24 hours under a per-product key derived from `storageKey`, so the bundle's five sites do not collide. Because an MV3 service worker cannot call `navigator.geolocation`, `offscreen.ts` runs in an offscreen document created with `Reason.GEOLOCATION` and answers a `get-geolocation` message, signalling `offscreen-ready` so the worker knows its listener is live before asking.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/geo/sun-times.ts#L1-L97 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/offscreen.ts "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/static/offscreen.html "source"
        core__offscreen_file = file "offscreen.ts" {
          technology "TypeScript"
          summary "Offscreen document that answers get-geolocation for the service worker and announces offscreen-ready."
          description '''
            Exists solely as an MV3 workaround, **because** sunrise/sunset scheduling needs `navigator.geolocation` and service workers have no such API.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/offscreen.ts#L1-L28 "source"
        }
        core__sun_times_file = file "geo/sun-times.ts" {
          technology "TypeScript"
          summary "roundCoordinate + cached fetch of the sunrise-sunset.org JSON API with formatted=0."
          description '''
            Rounding happens on the first two lines of `getSunTimes`, before both the cache read and the fetch, **because** the privacy claim is only true if no code path can transmit or persist precise coordinates.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/geo/sun-times.ts#L17-L60 "source"
        }
      }
      core__background_worker = component "Background service worker factory" {
        technology "TypeScript, Chrome MV3 service worker"
        summary "createSiteWorker/createBackgroundWorker: schedule resolution, alarms, geolocation brokering, Pro status, tab opening and install-time subscribe redirect."
        description '''
          One factory produces the MV3 service worker for any product. `createSiteWorker(config)` returns pure handlers with no listeners registered and `createBackgroundWorker(config)` wraps them with `chrome.runtime.onMessage`, `chrome.alarms.onAlarm` and `chrome.runtime.onInstalled` — the split exists **because** the Suite bundle runs five site configs in one worker and must register a single unified message listener instead of five duplicates. `getScheduleStatus()` is where all five theme modes resolve to a boolean, with sunrise/sunset falling back to the fixed schedule when coordinates or the API are unavailable. A 1-minute alarm re-evaluates and pushes `schedule-update` to matching tabs via `config.tabUrlPattern`. On first install it opens `${siteBase}/subscribe?token=...` and starts the checkout poller, **because** the token must reach the marketing site before the buyer starts a Stripe checkout.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/background/worker.ts#L1-L336 "source"
        core__worker_file = file "background/worker.ts" {
          technology "TypeScript"
          summary "SiteWorkerHandlers interface, offscreen-document lifecycle, alarm setup, and the standalone message-listener registration."
          description '''
            `sunCacheKeyFrom()` derives `gd_sun_times_cache` from `gd_preferences` (and `ds_gmail_*` for bundle sites), **because** the bundle hosts five sites in one extension and a shared sun-times cache would give Sheets whatever coordinates Gmail last used.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/background/worker.ts#L30-L82 "source"
        }
      }
      core__content_bootstrap = component "Content script bootstrap" {
        technology "TypeScript, React roots in host page"
        summary "createContentScript(config, sitePlugin) wires theme engine, prefs, payment, system detection, schedule messages, settings modal, toolbar/sidebar injection and shortcuts."
        description '''
          The composition root that runs inside Gmail, Sheets, Docs, Drive or any site. It is the code that makes '@darkly/core + one site plugin = a product' literally true, **because** every product's content entry is a one-line call to this factory with its own `ProductConfig` and `SitePlugin`. It resolves Pro status first, then branches: paid users get `applyMode()` plus live schedule updates; unpaid users still get a settings modal that renders the paywall. `getPageContext()` picks between the editor path (toolbar button + DOM observer re-injection + sidebar icon) and the dashboard path (header FAB). Keyboard toggle is wrapped in `gateProAction` here — the one place every extension's shortcuts are wired. It also revalidates the licence on tab visibility: throttled to 5s when unpaid so post-checkout unlock feels instant, and to 30 minutes when paid to catch revocation, reloading the page on any transition **because** the React panels hold `isPro` as a prop captured at init.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/content.ts#L1-L291 "source"
      }
      core__inject_kit = component "Host-page injection kit" {
        technology "TypeScript, React 18, MutationObserver"
        summary "Toolbar dropdown, sidebar panel, dashboard FAB, settings modal / mini panel mounting, DOM observer re-injection, keyboard chords and toast notifications."
        description '''
          Everything needed to put Darkly UI *inside* the host app rather than in a browser popup — the differentiator versus Dark Reader-style popups. `panels.tsx` mounts React roots (`createSettingsModal`, `createMiniPanel`) into prefixed DOM containers wrapped in `DarklyProvider`, **because** class names must carry the per-extension prefix so a standalone install and the bundle can coexist on one page. `toolbar-button.tsx` and `sidebar-icon.tsx` build the brand squircle as an inline base64 SVG in golden (dark) and blue (light) variants and wrap host icons in a coin, so the button matches Google's own toolbar affordances. `dom-observer.ts` re-injects when the host app rebuilds its toolbar — necessary **because** Sheets and Docs recreate toolbar DOM on navigation. `fab.ts` targets `header#gb [data-ogsr-up]` for Drive/Sheets/Docs dashboard pages where no editor toolbar exists. `keyboard-sequence.ts` implements two-key Gmail-style chords ('g' then shift+T) that the single-chord helper cannot express.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/inject/panels.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/inject/toolbar-button.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/inject/sidebar-icon.tsx "source"
        core__dom_observer_file = file "inject/dom-observer.ts" {
          technology "TypeScript"
          summary "MutationObserver helper that re-runs injection when the host app tears down our button."
          description '''
            Keeps the in-app entry point alive, **because** Google's SPA toolbars are rebuilt on navigation and a one-shot injection would silently vanish mid-session.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/inject/dom-observer.ts#L1-L56 "source"
        }
        core__fab_file = file "inject/fab.ts" {
          technology "TypeScript"
          summary "Dashboard-page icon injector targeting Google's global header (header#gb, [data-ogsr-up])."
          description '''
            Covers Sheets/Docs/Drive home screens where the editor toolbar does not exist, **because** settings must be reachable everywhere in the host app, not only inside an open document.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/inject/fab.ts#L1-L40 "source"
        }
        core__keyboard_sequence_file = file "inject/keyboard-sequence.ts" {
          technology "TypeScript"
          summary "Two-key chord matcher with an armed-prefix timeout, for Gmail-style 'g then shift+T' shortcuts."
          description '''
            Written **because** the single-chord helper splits on '+' and would mis-read 'g shift+t' as a bare 't', which would fire the toggle on ordinary typing in Gmail.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/inject/keyboard-sequence.ts#L1-L30 "source"
        }
        core__panels_file = file "inject/panels.tsx" {
          technology "React 18"
          summary "createSettingsModal (backdrop + focus restore + Esc) and createMiniPanel, both mounting React under DarklyProvider."
          description '''
            Builds container class names from `config.prefix` (`${p}-modal-backdrop`, `${p}-settings-container`), **because** the build-time CSS prefix loader rewrites the matching stylesheet selectors and only matching prefixes will style the panel.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/inject/panels.tsx#L18-L76 "source"
        }
        core__toolbar_button_file = file "inject/toolbar-button.tsx" {
          technology "React 18, SVG"
          summary "Brand squircle SVG (golden/blue), host-icon coin wrapper, toolbar dropdown hosting MiniControlPanel, and icon re-observation."
          description '''
            Generates the icon as an inline data URI instead of a packaged asset, **because** the injected button must render identically in Sheets and Docs toolbars without an extra web-accessible-resource declaration per extension.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/inject/toolbar-button.tsx#L1-L46 "source"
        }
      }
      core__settings_ui = component "Settings UI component library" {
        technology "React 18, lucide-react"
        summary "React settings panel, mode selector, mode detail panels, paywall, upgrade banner and shared primitives, all prefix-aware via usePrefix()."
        description '''
          The in-app settings surface the product sells: the same components render inside Gmail's InboxSDK sidebar, the Sheets/Docs toolbar dropdown and Browse Darkly's side panel. `SettingsPanel` owns preference state, subscribing through `createPreferencesManager` so changes made in one surface reflect in another. `ThemeModeSelector` + `ModeDetailPanel` expose the five modes with per-mode configuration (`ScheduleConfig` time range, `SunriseSunsetConfig` geolocation request). `renderProductSection` is the slot where a site plugin injects Sheets' Preserve Grid Colors or Docs' Preserve Page Colors toggle, **because** those data-accuracy switches are product-specific but must sit inside the shared panel chrome. `Paywall` renders individual versus Suite tiers selected by `config.productId`, with live Stripe prices overriding the hardcoded fallbacks — the bundle upsell surfaced at the point of friction. Every component reads its class prefix from `usePrefix()` **because** hardcoding `darkly-` would break the build-time prefix rewrite.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/ui/SettingsPanel.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/ui/Paywall.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/ui/MiniControlPanel.tsx "source"
        core__mini_panel_file = file "ui/MiniControlPanel.tsx" {
          technology "React 18"
          summary "Compact toolbar-dropdown control: enable toggle, mode switch, preset picker, All Settings link."
          description '''
            Gives Sheets/Docs users a one-click surface without leaving the spreadsheet, **because** the promise is settings that live inside the host app rather than behind a browser toolbar popup.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/ui/MiniControlPanel.tsx "source"
        }
        core__paywall_file = file "ui/Paywall.tsx" {
          technology "React 18"
          summary "Three-tier plan picker that swaps individual vs Suite pricing based on config.productId."
          description '''
            Encodes the 5 products x 3 plans catalogue on the client, **because** the buyer must see monthly/yearly/lifetime side by side with the Suite bundle framed as the better deal — the upsell mechanism a Suite licence then satisfies for every single-product query.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/ui/Paywall.tsx#L9-L37 "source"
        }
        core__settings_panel_file = file "ui/SettingsPanel.tsx" {
          technology "React 18"
          summary "Stateful settings root: loads prefs, subscribes to changes, renders mode selector, product section slot and Pro/paywall states."
          description '''
            Takes `plan`, `subscriptionStatus`, `cancelAt` and `prices` as props from the payment client, **because** the panel doubles as the subscription management surface (upgrade, restore purchase, Stripe portal) without a separate account UI in the extension.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/ui/SettingsPanel.tsx#L1-L60 "source"
        }
        core__sunrise_config_file = file "ui/SunriseSunsetConfig.tsx" {
          technology "React 18"
          summary "Geolocation permission request and sunrise/sunset display for the sun-based theme mode."
          description '''
            The user-facing consent step for the sunrise/sunset mode, **because** location is only requested when the user actively chooses that mode, keeping the CWS privacy story to approximate location used for one named purpose.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/ui/SunriseSunsetConfig.tsx#L1-L116 "source"
        }
      }
      core__conflict_detection = component "Page-claim mutex (data-darkly-active)" {
        technology "TypeScript, DOM attribute"
        summary "claimPage / releasePage / getPageOwner implementing the single-owner mutex on the html element so only one Darkly extension themes a page."
        description '''
          Directly implements the `data-darkly-active` mutex named in the product design. First extension to call `claimPage(id)` wins and writes its id to the attribute; any later claimant logs a warning and returns false, **because** a user can legitimately have both Darkly for Gmail and the Suite bundle installed and double-inversion would render Gmail unusable. Deliberately *not* prefixed — the attribute name is shared across all five products precisely so they can see each other, which is the inverse of the CSS prefix rule everywhere else in core.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/conflict-detection.ts#L1-L49 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/__tests__/conflict-detection.test.ts "source"
      }
      core__landing_bridge = component "Landing-page token bridge" {
        technology "TypeScript, CustomEvent"
        summary "Content script on marketing domains that hands the extension's UUID token to the page and forwards checkout-complete events back to the worker."
        description '''
          Closes the loop between the five marketing sites and the installed extension. It asks the background worker for the token, dispatches `darkly-extension-token` on `window` (also answering later `darkly-token-request` events), and forwards the page's `darkly-checkout-complete` event as a `checkoutComplete` runtime message that starts the checkout poller. Uses `chrome.runtime.sendMessage` rather than an extension-ID-addressed channel, **because** the same code must work for unpacked dev builds and the published CWS listings whose IDs differ — the site never needs to know an extension ID.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/landing-bridge.ts#L1-L43 "source"
      }
      core__test_suite = component "Core unit test suite (Jest + jsdom)" {
        technology "Jest 30, ts-jest, jest-environment-jsdom"
        summary "Jest/ts-jest suites covering theme engine, contrast, scheduler, preferences, payment client, gates, checkout poller, sun times, keyboard sequences, panels and the page mutex."
        description '''
          Guards the shared engine that all five products ship, **because** a regression in `@darkly/core` breaks every CWS listing at once rather than one. Coverage tracks the risky logic specifically: midnight-wrapping schedules, the preferences save queue under quota failures, the paid-only status cache, the three-phase checkout poller, coordinate rounding for the privacy claim, and the `data-darkly-active` first-claim-wins ordering across product id pairs.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/jest.config.js "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/__tests__/engine.test.ts "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/theme/__tests__/contrast.test.ts "source"
      }
    }
    site_plugins = container "Site plugins (@darkly/site-*)" {
      technology "TypeScript, React 18, CSS"
      description '''
        Per-surface plugin packages implementing the SitePlugin contract for Gmail, Sheets, Docs and Drive, plus the generic any-website engine behind Browse Darkly — because host-app specifics (InboxSDK, Waffle grid, Kix canvas, arbitrary sites) must stay out of the shared engine.
      '''
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-gmail/package.json "source"
      siteng__gmail_plugin = component "Gmail site plugin (@darkly/site-gmail)" {
        technology "TypeScript, React 18, @inboxsdk/core ^2.2.11"
        summary "SitePlugin for mail.google.com: InboxSDK sidebar settings panel, toolbar dropdown, 'g shift+t' toggle, and filter-based gmail-overrides.css."
        description '''
          Implements the `SitePlugin` contract for Gmail and is the only site package that depends on a third-party host-app SDK. `plugin.ts` exposes `gmailPlugin` with `siteId: 'gmail'` and match pattern `https://mail.google.com/*`; on `injectToolbarButton` it lazily loads InboxSDK, mounts the full React `GmailSettingsPanel` into the InboxSDK sidebar and registers a toolbar dropdown hosting `MiniControlPanel` from core. `startDomObserver` is deliberately a no-op because InboxSDK does its own DOM observation. Matters because the vision brief promises settings live *inside the host app* — for Gmail that is literally the InboxSDK sidebar, and this package is what realises it, including the upgrade/restore/manage-subscription callbacks that surface the Stripe paywall inside Gmail. Notable resilience detail: the theme-toggle keypress is matched by the extension's own sequence matcher in core (`registerToggleShortcut`), and InboxSDK is used only to *list* the chord in Gmail's `?` help dialog, so the shortcut keeps working when the SDK fails to load. The InboxSDK app id constant lives in `sdk/init.ts` as a lazily created singleton promise shared by every module. `pageWorld.ts` is a separate bundle entry re-exporting InboxSDK's page-world script, required because MV3 isolated worlds cannot reach Gmail's page context; it is shipped via `web_accessible_resources`.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-gmail/src/plugin.ts#L23-L106 "source"
        siteng__gmail_overrides_css = file "styles/gmail-overrides.css" {
          technology "CSS"
          summary "Filter-based inversion for Gmail: invert(1) hue-rotate(180deg) on body, media re-inversion, logo exceptions. Uses the darkly placeholder prefix."
          description '''
            The concrete expression of the brief's filter-based-inversion-over-per-class-overrides thesis, and it carries the build-time prefix placeholder (data-darkly-theme) that the CSS prefix loader rewrites to gd-/ds- so a standalone Gmail extension and the bundle can coexist.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-gmail/src/styles/gmail-overrides.css#L1-L40 "source"
        }
        siteng__gmail_plugin_entry = file "gmail plugin.ts" {
          technology "TypeScript"
          summary "gmailPlugin object: init, InboxSDK-backed toolbar/sidebar injection, keyboard shortcut registration with SDK-failure fallback."
          description '''
            The SitePlugin implementation consumed by both ext_gmail and ext_suite_bundle content scripts, because a single plugin object is how the monorepo composes @darkly/core plus one site package into a product.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-gmail/src/plugin.ts "source"
        }
        siteng__gmail_sdk_init = file "sdk/init.ts — InboxSDK singleton" {
          technology "TypeScript"
          summary "Lazy getSDK() promise wrapping InboxSDK.load(2, appId) so panel, toolbar and shortcut modules share one SDK instance."
          description '''
            Single point of InboxSDK initialisation, because every in-Gmail UI surface promised by the brief (sidebar panel, toolbar dropdown, shortcut help entry) must attach to the same SDK instance or Gmail renders duplicates.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-gmail/src/sdk/init.ts#L1-L16 "source"
        }
        siteng__gmail_shortcut = file "sdk/keyboard-shortcut.ts" {
          technology "TypeScript"

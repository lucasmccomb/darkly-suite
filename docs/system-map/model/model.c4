          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/admin/pages/AdminLicensesPage.tsx#L1-L80 "source"
        }

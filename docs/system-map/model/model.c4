          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-browse/wrangler.toml "source"
        }
      }
    }
    web_darklysuite = container "darklysuite.com (hub site)" {
      technology "Vite 7, React 19, react-router 7, Cloudflare Pages"
      summary "Vite + React 19 site on Cloudflare Pages: product pages for all five SKUs, subscribe/success/setup flows, account and admin portals."
      description '''
        The commercial hub, deployed as Cloudflare Pages project `darkly-suite`.
        
        Routes cover Home, Suite, Gmail, Sheets, Docs, Subscribe, Success, Setup, Support and Privacy, and it mounts the shared account portal (session, subscriptions, Stripe billing portal, logout) and admin portal from `@darkly/landing-shared`.
        
        It is the only landing package that carries both the D1 binding and the Functions tsconfig **because every extension's checkout link and licence check points at darklysuite.com, so this one deployment is the single storefront and licence authority for all five products**. The README documents three redundant deploy paths (Cloudflare git integration, the GitHub Actions workflow, and manual `wrangler pages deploy dist`) precisely because a storefront outage stops all revenue.
      '''
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/package.json "source"
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/wrangler.toml "source"
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/App.tsx "source"
      link https://darklysuite.com "site"
      lsuite__checkout_flow = component "Subscribe / Success / Setup purchase flow" {
        technology "React, react-router-dom search params, @darkly/landing-shared hooks"
        summary "Three-page post-CTA flow: plan choice, Stripe return landing with licence activation, and the install/activate setup guide."
        description '''
          The purchase-to-activation journey, **because** identity is a UUID token in chrome.storage.sync with no account: `/subscribe?product=X` renders shared `SubscribeContent` with the right tier set and an `authBaseUrl` of `/api/auth/start` (Google sign-in for restoring an existing purchase); `/success?product=X` calls the shared `useCheckoutComplete(product)` hook to finish licence handoff back to the extension after Stripe redirects, and shows the `SetupGuide` unless `?restored=true`, in which case it renders a "Purchase Restored" state and a Return-to-Gmail button; `/setup?product=X` re-renders that same `SetupGuide` standalone with `STORE_URLS`, so a buyer who lost the tab can still install the extension and pick the token up.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SubscribePage.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SuccessPage.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SetupPage.tsx "source"
        lsuite__file_setup_page = file "SetupPage.tsx" {
          technology "React"
          summary "Standalone tabbed setup guide with per-product Chrome Web Store install links."
          description '''
            Recovers the activation path **because** a paid token is useless until the matching MV3 extension is installed; the page hands `STORE_URLS` to the shared `SetupGuide` so each tab deep-links to the correct Chrome Web Store listing, backed by the walkthrough images in `public/images/setup/`.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SetupPage.tsx#L6-L30 "source"
        }
        lsuite__file_subscribe_page = file "SubscribePage.tsx" {
          technology "React"
          summary "Plan-selection page keyed on ?product=, defaulting to the suite bundle, with Google sign-in for purchase restore."
          description '''
            Entry point extensions link to when a trial lapses **because** it accepts `?product=` and defaults to `suite`, steering ambiguous traffic at the bundle; it passes `AUTH_API_URL` (`/api/auth/start`) so an existing customer can sign in with Google and restore a licence instead of paying twice.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SubscribePage.tsx#L12-L31 "source"
        }
        lsuite__file_success_page = file "SuccessPage.tsx" {
          technology "React"
          summary "Stripe post-checkout landing that runs useCheckoutComplete and renders the setup guide or a restored-purchase confirmation."
          description '''
            The moment the licence reaches the browser **because** `useCheckoutComplete(product)` is what lets the extension pick the token up (via landing-bridge content script / externally_connectable messaging) immediately after Stripe redirects back to `/success?product=...`; the `?restored=true` branch serves the sign-in restore path rather than a fresh purchase.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SuccessPage.tsx#L1-L20 "source"
        }
      }
      lsuite__legal_pages = component "Privacy and Support pages" {
        technology "React static content pages"
        summary "Locally authored compliance and help content covering all Darkly products, required for Chrome Web Store listings and paid support."
        description '''
          Satisfies the store and commerce obligations of the hub, **because** every paid MV3 listing needs a published privacy policy and a support contact: `PrivacyPage` states the policy for the whole family (Gmail, Sheets, Docs, Drive/Suite) with a last-updated date, and `SupportPage` publishes the support@darklysuite.com mailbox, a 24-hour response promise, and an activation FAQ — matching the "Priority email support" line item sold in every pricing tier.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/PrivacyPage.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SupportPage.tsx "source"
        lsuite__file_privacy_page = file "PrivacyPage.tsx" {
          technology "React"
          summary "Privacy policy covering all Darkly products, referenced from the footer of every page."
          description '''
            Required to ship paid extensions **because** Chrome Web Store listings for all five SKUs point at a policy URL on darklysuite.com, and the token-only identity model (no account) is exactly what this page has to explain to buyers.

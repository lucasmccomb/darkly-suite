        }
        siteng__docs_overrides_css = file "styles/docs-overrides.css" {
          technology "CSS"
          summary "Body inversion, media re-inversion, and data-darkly-page='preserve' rules re-inverting .kix-canvas-tile-content and .kix-page."
          description '''
            Holds the Preserve Page Colors capability named in the brief, because the Kix canvas is a bitmap surface where only a counter-filter can restore an accurate white page under whole-document inversion.

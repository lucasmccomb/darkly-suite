      lsh__checkout_client = component "Browser-side token bridge and checkout URLs" {
        technology "TypeScript, React hooks, CustomEvent bridge"
        summary "Builds direct and OAuth checkout URLs, and detects an installed extension's UUID token through a CustomEvent content-script bridge."
        description '''
          Connects the marketing page to the extension's identity, because the licence is keyed on the UUID token in chrome.storage.sync and the page must use that exact token when sending the visitor to Stripe. `getExtensionToken` dispatches `darkly-token-request` and listens for `darkly-extension-token` from the landing-bridge content script (chosen over `externally_connectable` so unpacked and CWS builds both work), timing out at 2s. `getOrCreateToken` falls back to a URL token, then sessionStorage, then a fresh `crypto.randomUUID()`, so a visitor without the extension can still buy and be reconciled later. `notifyCheckoutComplete` fires `darkly-checkout-complete` on the success page to wake the extension's licence poller, and `buildOAuthCheckoutUrl` routes the subscribe flow through /api/auth/start so Stripe receives a Google-verified email.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/utils/checkout.ts "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/utils/extension-bridge.ts "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/hooks/useExtensionToken.ts "source"
        lsh__checkout_utils_file = file "utils/checkout.ts" {
          technology "TypeScript"
          summary "buildCheckoutUrl, buildOAuthCheckoutUrl and getOrCreateToken with its sessionStorage fallback chain."
          description '''
            Decides which token a purchase is attributed to, because attributing a Stripe session to the wrong UUID would grant the licence to a device the buyer does not use; the sessionStorage reuse keeps the token stable across a cancel-and-retry on Stripe.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/utils/checkout.ts#L1-L73 "source"
        }
        lsh__ext_bridge_file = file "utils/extension-bridge.ts" {
          technology "TypeScript, DOM CustomEvent"
          summary "CustomEvent protocol between the page and the extension's landing-bridge content script for token retrieval and checkout completion."
          description '''
            The only channel by which a marketing site learns that an extension is installed and what its token is, because the page cannot read chrome.storage.sync directly and the ID-free event bridge works for both unpacked dev builds and published CWS listings.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/utils/extension-bridge.ts#L1-L60 "source"
        }
        lsh__ext_token_hook_file = file "hooks/useExtensionToken.ts" {
          technology "React"
          summary "React hook wrapping extension token detection on mount."
          description '''
            Lets any pricing or subscribe surface adopt the installed extension's identity with one line, because every buy button on every site needs the same detection before it can build a checkout URL.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/hooks/useExtensionToken.ts#L1-L19 "source"
        }
      }
      lsh__admin_portal_ui = component "Admin portal UI" {
        technology "React 19, react-router-dom, CSS"
        summary "React admin shell with auth context, sidebar routing and Memberships / Discount Codes / Stats pages plus licence-detail and code modals."
        description '''
          The operator-facing front end for the ADMIN_EMAIL-gated portal in the vision brief, because a solo operator needs to look up a customer's licence, issue or revoke a discount code and read revenue-shaped stats without SSHing into anything. `AdminAuthProvider` probes /api/admin/session on mount and `AdminLayout` redirects to the login page when unauthenticated, so the client never renders admin data without a valid server session. Pages talk to the admin API with `credentials: 'same-origin'`; the licences page uses the POST search contract so customer emails stay out of URLs, and modals cover licence detail (with live Stripe data), code share, code edit, delete confirmation and toasts. It is exported from the shared package but mounted by the site that hosts the API.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/admin/AdminLayout.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/admin/AdminAuthContext.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/src/admin/pages/AdminLicensesPage.tsx "source"
        lsh__admin_css_file = file "styles/admin.css" {
          technology "CSS"
          summary "Dark admin design system: layout, sidebar, tables, badges, modals, toasts and spinners, reused by the account portal."
          description '''
            Gives both back-office surfaces one look, because the account portal pages reuse the same `admin-page`, `admin-table` and badge classes rather than shipping a second stylesheet.
          '''

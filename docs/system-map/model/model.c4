    repo_tooling = container "Build, CI and release tooling" {
      technology "webpack 5, GitHub Actions, Bash"
      description '''
        The CSS prefix loader, CI and deploy workflows, D1 migration, domain proxies, release scripts, planning docs and workspace config — because one monorepo compiles five prefix-isolated extensions and deploys five sites, and that machinery is its own subsystem.
      '''
      link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/build-tools/darkly-prefix-loader.js "source"
      misc__prefix_loader = component "CSS Prefix Loader and Webpack Build Factory" {
        technology "Node.js, webpack 5 loader/plugin API"
        summary "build-tools workspace package: webpack loader rewriting darkly- CSS tokens to gd-/sd-/dd-/ds-/bd-, a shared config factory, and a third-party licence collector."
        description '''
          The `build-tools` package is the mechanism that makes one shared codebase compile into five distinct Chrome MV3 extensions, **because** the vision requires a standalone extension and the Suite bundle to be installed side-by-side without CSS collisions.
        
          `darkly-prefix-loader.js` is a plain webpack loader that takes a `prefix` option (`gd`, `sd`, `dd`, `ds`, `bd`) and does three build-time string substitutions on every CSS file: `.darkly-` to `.{prefix}-` (class names), `--darkly-` to `--{prefix}-` (custom properties), and `data-darkly-` to `data-{prefix}-` (data attributes). A missing `prefix` option raises a webpack error rather than silently shipping unprefixed CSS. This is one of three prefix-resolution strategies documented in README.md; the other two (a React `usePrefix()` context and `ProductConfig.prefix` injection) live outside this area in `@darkly/core`.
        
          `webpack.factory.js` exposes `createDarklyWebpackConfig({ prefix, packageDir, entry, copyPatterns, alias })`, wiring `ts-loader` (transpileOnly), the `style-loader / css-loader / darkly-prefix-loader` chain, a `CopyPlugin` for `static/` to `dist/`, and `ThirdPartyLicensesPlugin`. Every extension package builds from this factory, so prefixing is not opt-in.
        
          `collect-licenses.js` walks an extension's production dependency tree with no external deps, following pnpm's symlinked store via `realpathSync`, skipping first-party `@darkly/*` packages as attribution targets while still traversing their deps, and emits a deterministic `THIRD-PARTY-LICENSES.txt` into each build — required **because** MIT/BSD/ISC/Apache terms oblige every Chrome Web Store zip to carry upstream copyright and licence text.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/build-tools/darkly-prefix-loader.js#L20-L43 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/build-tools/webpack.factory.js#L27-L87 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/build-tools/collect-licenses.js#L1-L45 "source"
        misc__license_collector_file = file "collect-licenses.js" {
          technology "Node.js (fs/path only, zero deps)"
          summary "Dependency-tree walker producing deterministic THIRD-PARTY-LICENSES.txt per extension; usable as a webpack plugin or a CLI."
          description '''
            Generates the attribution file that ships inside every extension zip **because** Chrome Web Store distribution of MIT/BSD/ISC/Apache-licensed bundled code requires preserving copyright and licence text. Resolves packages by walking `node_modules` upward and calling `realpathSync` to see through pnpm's content-addressable symlink store, and excludes first-party `@darkly/*` workspace packages from attribution while still traversing their production dependencies.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/build-tools/collect-licenses.js#L1-L60 "source"
        }
        misc__prefix_loader_file = file "darkly-prefix-loader.js" {
          technology "JavaScript"
          summary "43-line webpack loader performing the three regex substitutions that turn canonical darkly- CSS tokens into a per-extension prefix."
          description '''
            The single file that implements per-product CSS namespacing, **because** without it the five extensions' stylesheets would fight over identical class names and custom properties when co-installed. Reads `this.getOptions().prefix`, emits a build error if absent, then applies the three global replacements to the source. Note it rewrites `data-darkly-` too, which interacts with the `data-darkly-active` conflict-detection attribute described in CLAUDE.md.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/build-tools/darkly-prefix-loader.js#L1-L43 "source"
        }
        misc__webpack_factory_file = file "webpack.factory.js" {
          technology "webpack 5, ts-loader, copy-webpack-plugin"
          summary "Shared createDarklyWebpackConfig() factory that every extension package merges with dev/prod settings."
          description '''
            Centralises the MV3 build shape for all five extensions **because** content scripts, background service workers, and page-world scripts have different runtime constraints that would otherwise be re-solved per package. It hard-wires the prefix loader into the CSS rule chain so no extension can accidentally ship unprefixed styles, and registers `ThirdPartyLicensesPlugin` so every store zip carries attribution.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/build-tools/webpack.factory.js#L38-L87 "source"
        }
      }
      misc__ci_workflow = component "CI Workflow and PR Hygiene" {
        technology "GitHub Actions, pnpm 9, Node 20, Dependabot"
        summary "GitHub Actions CI running pnpm -r lint / type-check / test in parallel then build, plus SHA-pinned actions, Dependabot, and a PR checklist template."
        description '''
          The quality gate for a monorepo maintained by a single operator, **because** one `@darkly/core` change can break five extensions and four marketing sites at once, so every push to `main` and every PR must prove the whole workspace still compiles.
        
          `ci.yml` defines four jobs on `ubuntu-latest` with Node 20 and pnpm 9: `lint`, `type-check`, and `test` run in parallel, and `build` runs only after all three pass (`needs: [lint, type-check, test]`). Each job checks out with `persist-credentials: false`, installs with `--frozen-lockfile` for reproducibility, and runs the corresponding recursive script from the root `package.json`. A concurrency group keyed on workflow + ref cancels superseded in-progress runs.
        
          Supply-chain posture is deliberate: every third-party action is pinned to a full-length commit SHA with a trailing version comment, and `dependabot.yml` schedules weekly `github-actions` updates precisely because Dependabot understands that pin-plus-comment convention and bumps both together. Workflow `permissions` are narrowed to `contents: read`.
        
          `PULL_REQUEST_TEMPLATE.md` encodes the same gate for humans: a checkbox per affected package and a test plan requiring the four `pnpm -r` commands plus manual Chrome verification — the same sequence CONTRIBUTING.md and CLAUDE.md call pre-push verification.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/ci.yml#L1-L84 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/dependabot.yml#L1-L10 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/PULL_REQUEST_TEMPLATE.md#L1-L37 "source"
        misc__ci_yml_file = file ".github/workflows/ci.yml" {
          technology "GitHub Actions YAML"
          summary "Four-job CI: lint, type-check, test fan out in parallel; build gates on all three."
          description '''
            Enforces that lint, TypeScript strict mode, unit tests, and a full webpack build all pass before `main` advances, **because** the composition model (@darkly/core + one @darkly/site-* plugin per product) means a regression in shared code is a regression in all five Chrome Web Store products simultaneously.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/ci.yml#L16-L84 "source"
        }
      }
      misc__deploy_landing_workflow = component "Landing Page Deploy Workflow" {
        technology "GitHub Actions, cloudflare/wrangler-action, Cloudflare Pages"
        summary "Path-filtered GitHub Actions workflow deploying four marketing sites to Cloudflare Pages via wrangler-action, with landing-shared fanning out to all of them."
        description '''
          Automates the marketing-site half of distribution, **because** the product ships five Chrome Web Store listings alongside per-product landing sites and each site must be redeployable independently without a full-fleet rebuild.
        
          A `detect-changes` job checks out with `fetch-depth: 2`, diffs `HEAD~1..HEAD`, and sets four boolean outputs. The key rule: any change under `packages/landing-shared/` sets `SHARED_CHANGED=true` and forces all four sites to deploy — matching the vision's "a landing-shared change redeploys all sites". Otherwise each site deploys only when its own package changed. `workflow_dispatch` adds manual override inputs (`deploy-all` plus one checkbox per site) that bypass diffing entirely.
        
          Four near-identical deploy jobs then run conditionally, each installing with `--frozen-lockfile`, building via `pnpm --filter @darkly/landing-x build`, and invoking `cloudflare/wrangler-action` with `pages deploy dist --project-name=y`: `gmail-darkly` for gmaildarkly.com, `sheets-darkly` for sheetsdarkly.com, `docs-darkly` for docsdarkly.com, `darkly-suite` for darklysuite.com. Credentials come from repository secrets for a Cloudflare API token and account ID (names only; values are not in the repo).
        
          The concurrency group uses `cancel-in-progress: false`, so deploys queue rather than being killed mid-upload. README.md frames this as one of three redundant deploy paths, the others being Cloudflare's own git integration and a manual local `wrangler pages deploy dist`.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/deploy-landing.yml#L1-L261 "source"
        misc__deploy_landing_file = file ".github/workflows/deploy-landing.yml" {
          technology "GitHub Actions YAML, bash"
          summary "detect-changes job plus four conditional Cloudflare Pages deploy jobs, one per marketing domain."
          description '''
            Contains the change-detection shell logic that decides which marketing sites redeploy, **because** the four landing sites share `@darkly/landing-shared` and a shared-package edit must fan out to every domain while a single-site edit must not. Deploy jobs map pnpm filters to Cloudflare Pages project names, which is the only place in the repo linking package to Pages project to public domain.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/deploy-landing.yml#L42-L125 "source"
        }
      }
      misc__d1_migration = component "D1 Licence Consolidation Script" {
        technology "Bash, wrangler CLI, Node.js, Cloudflare D1 (SQLite)"
        summary "Bash + wrangler script exporting licences from three legacy per-product D1 databases and re-inserting them into the unified database keyed on (token, product)."
        description '''
          Executes the database half of the consolidation story, **because** the licensing backend moved from three per-product D1 databases to one shared licence database whose primary key gained a `product` column, and existing paying customers' licences had to survive that move.
        
          For each of `gmail`/`sheets`/`docs` it runs `wrangler d1 execute` with a SELECT over the legacy licences table using `--json`, then shells out to inline Node to read the results, escape single quotes, and generate one `INSERT INTO licenses (...) VALUES (...) ON CONFLICT (token, product) DO NOTHING;` per row — the conflict clause making the migration idempotent and re-runnable. Generated SQL is applied with `wrangler d1 execute --file`.
        
          Operational affordances: `--dry-run` prints the SQL instead of executing it, `--product` narrows to one legacy database, `set -euo pipefail` aborts on the first failure, and a `mktemp -d` working directory is removed by an EXIT trap. It closes with an exported-vs-imported summary. The script pairs with the domain-proxy Workers: the proxies keep legacy `/api/*` traffic answerable while this script moves the underlying rows.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/migrate-d1.sh#L1-L166 "source"
      }
      misc__domain_proxies = component "Legacy Domain Proxy Workers" {
        technology "Cloudflare Workers (module syntax), wrangler TOML"
        summary "Three thin Cloudflare Workers forwarding gmaildarkly/sheetsdarkly/docsdarkly /api/* to darklysuite.com with a product query param injected from a per-deploy env var."
        description '''
          Keeps already-installed extensions working after the backend consolidated onto darklysuite.com, **because** published extension builds (Gmail is live at 1.0.2 on the Chrome Web Store) still point their licensing calls at the legacy per-product domains and cannot be force-updated on the operator's schedule.
        
          One source file, `proxy-worker.js`, is deployed three times with different config. The handler answers `OPTIONS` preflights with permissive CORS headers, rejects any path outside `/api/*` with a 404 JSON body, and returns a 500 if the `PRODUCT` env var is unset. Otherwise it rebuilds the URL against `darklysuite.com`, copies incoming query params, and sets the `product` parameter only if not already present. Cloudflare-injected headers are stripped before forwarding; `Host` is rewritten. The upstream response is streamed back with CORS headers merged in, and a fetch failure becomes a 502 with a JSON detail body.
        
          Each `wrangler.{product}.toml` sets a name (e.g. `proxy-gmaildarkly`), `main = proxy-worker.js`, a `[vars] PRODUCT` value, and a single route `{olddomain}/api/*` scoped to that zone — so only API paths are intercepted and the legacy marketing sites keep serving from Cloudflare Pages. The colocated README documents deploy commands and, notably, a teardown plan once every extension build targets darklysuite.com directly, marking this as intentionally temporary infrastructure.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/domain-proxies/proxy-worker.js#L1-L122 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/domain-proxies/wrangler.gmail.toml#L1-L16 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/domain-proxies/wrangler.sheets.toml#L1-L16 "source"
        misc__proxy_worker_file = file "scripts/domain-proxies/proxy-worker.js" {
          technology "Cloudflare Workers"
          summary "Single Worker fetch handler: CORS preflight, /api/* path guard, product param injection, CF header stripping, 502 on upstream failure."
          description '''
            The whole proxy behaviour in one 122-line module, **because** the consolidated licensing API distinguishes products by a `product` query parameter that legacy-domain callers never send. Deployed three times with `PRODUCT` differing per wrangler config rather than branching in code.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/domain-proxies/proxy-worker.js#L42-L122 "source"
        }
      }
      misc__release_scripts = component "Release Version and Change-Check Scripts" {
        technology "Bash, git tags"
        summary "Two bash helpers: manifest.json semver bumping per extension, and a git-tag-diff report of unreleased commits across each extension's dependency paths."
        description '''
          Supports the manual Chrome Web Store release cadence, **because** only Gmail is published (1.0.2) and each of the five listings versions independently from a `static/manifest.json` rather than from npm package versions.
        
          `release-check.sh` encodes the composition graph as a dependency map — `gmail-darkly` watches its own package plus core plus site-gmail, `darkly-suite` watches its own package plus core plus all three site plugins — then finds the newest `{extension}-v*` git tag, runs `git log tag..HEAD -- paths`, and reports either "up to date" or the unreleased commit list alongside the current manifest version. This makes the core-plus-plugin composition visible at release time: a `@darkly/core` commit shows up as unreleased work for every extension.
        
          `release-bump.sh {extension} {patch|minor|major}` validates the extension name against a fixed list, greps the current version out of the manifest, splits it on `.`, applies the bump, and rewrites the line with BSD `sed -i ''` (macOS-specific). Both scripts run under `set -euo pipefail`. They are steps 3 and 4 of the Chrome Web Store submission runbook in `docs/cws-submission-process.md`, which also defines the post-submission tagging step that feeds `release-check.sh` on the next cycle.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/release-check.sh#L1-L81 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/release-bump.sh#L1-L89 "source"
      }
      misc__docs_corpus = component "Planning, Research and Store-Process Docs" {
        technology "Markdown"
        summary "Five long-form documents: the Browse Darkly product plan, Shadow DOM research, a single-app consolidation proposal, the CWS submission runbook, and the project story."
        description '''
          The design and operations corpus behind decisions that the code alone does not explain, **because** a solo operator running five commercial listings needs the reasoning for architecture pivots and a repeatable store-submission procedure written down.
        
          `browse-darkly-plan.md` (~1,250 lines) is the specification for the fifth product — the one that darkens every site rather than Google Workspace: opportunity and differentiator analysis, a deep teardown of Dark Reader's dynamic theme engine, a proposed optimised engine, a pre-computed override database, security/privacy architecture, Shadow DOM strategy, a site-fix system, extension architecture, pricing, phased multi-agent build plan, and a competitive matrix.
        
          `shadow-dom-research.md` (~1,000 lines) backs that plan with primary research: shadow-DOM prevalence on popular sites, `adoptedStyleSheets`, open vs closed roots, inheritance across boundaries, MutationObserver strategies, Dark Reader's approach, performance at scale, and `@layer` inside shadow roots.
        
          `cws-submission-process.md` is the operational runbook for the Chrome Web Store: prerequisites (landing page live with `/privacy`, licensing API answering, Stripe prices configured), the store-assets file inventory, creating a 100%-off reviewer promo code via Stripe CLI, the eleven submission steps, post-submission git tagging, a per-product domain table, and a submissions log recording Gmail as submitted 2026-02-19 and published while Sheets and Docs are unsubmitted.
        
          `darkly-suite-single-app-plans.md` proposes collapsing the four Workspace extensions into one tiered extension. `project-story.md` is a living narrative of the build — the ExtensionPay-to-Stripe/D1 switch, the pivot from ~1,080 lines of hand-written Gmail overrides to filter-based inversion, and the three-repo-to-monorepo consolidation.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/docs/browse-darkly-plan.md#L1-L40 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/docs/cws-submission-process.md#L1-L60 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/docs/shadow-dom-research.md#L1-L30 "source"
        misc__cws_process_file = file "docs/cws-submission-process.md" {
          technology "Markdown, Stripe CLI"
          summary "Eleven-step Chrome Web Store runbook plus reviewer promo-code creation, post-approval tagging, and a per-product submissions log."
          description '''
            The repeatable path from repo to store listing, **because** distribution depends on five separate Chrome Web Store submissions and only Gmail has cleared review so far. Notably ties store review to the paid product: it requires a Stripe 100%-off single-use promo code in the reviewer test instructions so the paywalled features can be evaluated.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/docs/cws-submission-process.md#L8-L235 "source"
        }
        misc__project_story_file = file "docs/project-story.md" {
          technology "Markdown"
          summary "Living narrative of the build: Gmail origin, ExtensionPay to Stripe/D1, filter-inversion pivot, three repos to one pnpm monorepo."
          description '''
            Records why the architecture looks the way it does, **because** the monorepo's core-plus-site-plugin composition and its Cloudflare/Stripe licensing backend were both replacements for earlier approaches (three duplicated repos; a third-party payment service taking a percentage per transaction) whose costs are not visible in the current code.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/docs/project-story.md#L1-L60 "source"
        }
      }
      misc__repo_governance = component "Repo Documentation and Governance" {
        technology "Markdown"
        summary "README architecture guide, CLAUDE.md agent operating manual, CONTRIBUTING, SECURITY policy, and the source-available NOTICE."
        description '''
          Defines how the repository is read, operated, and licensed, **because** the source is published as a public work sample for a commercial product, so it must explain the architecture while withholding any grant to reuse it.
        
          `README.md` (435 lines) is the architecture reference: Chrome Web Store launch status, repository structure, the prefix table (`gd`/`sd`/`dd`/`ds`/`bd` with class, variable, and storage-key examples) and its three resolution strategies, the package dependency graph, theme system, the filter-inversion dark-mode strategy, build system, conflict detection, per-extension detail, landing pages, payment system, testing, and a CI/CD section describing three redundant Cloudflare Pages deploy paths.
        
          `CLAUDE.md` (371 lines) is the operator/agent manual: a session-start Chrome Web Store status check, pre-push verification, dev-mode-only build rules, Chrome extension context rules, ThemeEngine save rules, Stripe CLI usage, a step-ordered runbook for resetting a user to free state across Stripe and the `darkly-suite-db` D1 database, conflict detection via `data-darkly-active`, and the Cloudflare Pages environment variables (names only; no values in the repo).
        
          `NOTICE` and `CONTRIBUTING.md` state the source-available-but-not-open-source position and decline outside pull requests; `SECURITY.md` sets a private disclosure address with a 48-hour acknowledgement target and scopes reports to the five extensions, the sites and payment backend, and the Cloudflare Workers/D1 under the same account.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/README.md#L1-L63 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/CLAUDE.md#L1-L60 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/CONTRIBUTING.md#L1-L48 "source"
        misc__claude_md_file = file "CLAUDE.md" {
          technology "Markdown"
          summary "Operator manual: dev-mode build rules, Stripe CLI conventions, D1 licence-cleanup runbook, and the Cloudflare Pages env-var inventory."
          description '''
            Captures the runtime operations that no code file encodes, **because** the licensing backend spans Stripe, Cloudflare D1, and Google OAuth, and correcting a customer's licence requires a specific cross-system order (cancel subscription, clear FK references, delete licence, delete sessions). Lists required Pages bindings including fifteen Stripe price variables by name only.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/CLAUDE.md#L266-L371 "source"
        }
        misc__readme_file = file "README.md" {
          technology "Markdown"
          summary "435-line architecture guide: prefix system, dependency graph, dark-mode strategy, conflict detection, CI/CD and three deploy paths."
          description '''
            The single best map of the composition model, **because** it documents the `darkly-` prefix table and the three resolution strategies (build-time CSS loader, React `usePrefix()` context, `ProductConfig` injection) that let a standalone extension and the Suite bundle coexist in one browser.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/README.md#L134-L175 "source"
        }
      }
      misc__workspace_config = component "Workspace and Toolchain Configuration" {
        technology "pnpm 9 workspaces, TypeScript 5 strict, ESLint 8"
        summary "Root pnpm workspace definition, recursive script surface, dependency overrides, shared strict tsconfig, ESLint config, and build-time global declarations."
        description '''
          The wiring that makes the monorepo a single buildable unit, **because** every extension is composed at build time from `@darkly/core` plus a `@darkly/site-*` plugin and must resolve those as workspace links rather than published packages.
        
          `pnpm-workspace.yaml` declares just two globs — `packages/*` and `build-tools` — which is why the prefix loader is importable as `@darkly/build-tools`. The root `package.json` is private and `UNLICENSED`, pins node and pnpm minimums, and exposes the recursive scripts CI invokes (`lint`, `type-check`, `test`, `build`) plus per-product `dev:*` and `build:*` filters covering gmail, sheets, docs, suite, browse, and four landing sites. Its `pnpm.overrides` block force-resolves transitive dependencies (handlebars, lodash, serialize-javascript, rollup, picomatch, and version-ranged pins for ajv, flatted, brace-expansion) — a supply-chain control on code that ends up inside published extensions.
        
          `tsconfig.base.json` sets the shared compiler contract every package extends: ES2020 target/module, DOM libs, `jsx: react-jsx`, `strict: true`, `moduleResolution: bundler`, `isolatedModules`, and `noEmit`. `.eslintrc.js` is the root ESLint 8 config layering `@typescript-eslint`, `react`, and `react-hooks` recommended sets.
        
          `globals.d.ts` declares the two webpack-injected compile-time constants, `__DEV_MODE__` and `__PRODUCT_ID__` — the former gating the paywall bypass in dev builds, the latter identifying which of the five products a shared module is running inside.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/package.json#L1-L56 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/pnpm-workspace.yaml#L1-L3 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/tsconfig.base.json#L1-L20 "source"
        misc__globals_dts_file = file "globals.d.ts" {
          technology "TypeScript ambient declarations"
          summary "Declares the two webpack-injected constants: __DEV_MODE__ and __PRODUCT_ID__."
          description '''
            Types the build-time switches that shared code branches on, **because** `__DEV_MODE__` disables the paywall in local builds and `__PRODUCT_ID__` tells a shared module which of the five products it was compiled into — the TypeScript counterpart to the CSS prefix loader's build-time rewriting.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/globals.d.ts#L1-L2 "source"
        }
        misc__root_package_file = file "package.json (root)" {
          technology "pnpm"
          summary "Private UNLICENSED root: recursive lint/type-check/test/build scripts, per-product dev/build filters, and pnpm dependency overrides."
          description '''
            The command surface both CI and the operator use, **because** five extensions and five sites are built from one tree and each needs an addressable pnpm filter. The `pnpm.overrides` map forces safe versions of transitive dependencies that would otherwise be bundled into published extension zips.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/package.json#L6-L56 "source"
        }
      }
    }
  }
  cloudflare_pages = cloud_provider "Cloudflare Pages" {
    technology "Cloudflare Pages + Pages Functions, wrangler-action"
    summary "Hosts all five marketing landing sites plus the Pages Functions API that backs checkout, licensing, and the account portal."
    description '''
      Every `landing-*` package declares `pages_build_output_dir = "dist"` and CI deploys each one with `cloudflare/wrangler-action` running `pages deploy dist --project-name=...` (projects `gmail-darkly`, `sheets-darkly`, `docs-darkly`, `darkly-suite`). The suite project is not just static: `packages/landing-shared/functions/api/**` are Pages Functions re-exported by landing-suite routes, so Cloudflare Pages **runs the payment/licence backend because the Chrome extensions must call `https://darklysuite.com/api/*` for checkout, licence status, and the admin console from any browser**. Deploy credentials arrive as GitHub Actions secrets (a Cloudflare API token and account ID), never committed.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/deploy-landing.yml "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/wrangler.toml "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/wrangler.toml "source"
    link https://developers.cloudflare.com/pages/ "site"
  }
  cloudflare_workers = cloud_provider "Cloudflare Workers (domain proxies)" {
    technology "Cloudflare Workers, wrangler routes"
    summary "Three standalone Workers proxy legacy per-product domains' /api/* traffic to the unified darklysuite.com backend during migration."
    description '''
      `scripts/domain-proxies/proxy-worker.js` plus `wrangler.gmail.toml`, `wrangler.sheets.toml`, `wrangler.docs.toml` deploy one Worker per legacy domain, each with a route like `gmaildarkly.com/api/*` and a `PRODUCT` var. They rewrite requests to `darklysuite.com` and inject the product parameter, **because older installed extension builds still point at their original per-product API host and would lose licence verification if those domains stopped answering**. These are deployed manually via `wrangler deploy --config ...`, not by the CI workflow.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/domain-proxies/proxy-worker.js "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/domain-proxies/wrangler.gmail.toml "source"
    link https://developers.cloudflare.com/workers/ "site"
  }
  chrome_sync_storage = datastore "Chrome Sync Storage (chrome.storage.sync)" {
    technology "Chrome extension storage.sync API"
    summary "Browser-managed, Google-account-synced key-value store holding user theme preferences and the licence token on each device."
    description '''
      `packages/core/src/storage/preferences.ts` and `packages/core/src/payment/client.ts` read/write `chrome.storage.sync` (preferences and the product `tokenKey`); `packages/browse-darkly/src/background.ts` reads the same token. This is an externally-operated datastore synced by Google across the user's signed-in Chrome profiles, used **because a licence purchased once should light up the extension on every machine the user signs into, and theme choices should follow them there too**. The preferences layer explicitly handles write failures under Chrome's sync write quotas by keeping the save queue alive.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/storage/preferences.ts "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/payment/client.ts "source"
    link https://developer.chrome.com/docs/extensions/reference/api/storage "site"
  }
  cloudflare_d1 = datastore "Cloudflare D1 (darkly-suite-db)" {
    technology "Cloudflare D1 (SQLite)"
    summary "SQLite-at-the-edge database bound as DB to landing-suite; stores licenses, discount codes, user sessions, and Stripe webhook dedupe records."
    description '''
      `packages/landing-suite/wrangler.toml` binds `[[d1_databases]] binding = "DB", database_name = "darkly-suite-db"`. The canonical schema in `packages/landing-shared/d1/schema.sql` defines `licenses` (token + product composite key, `stripe_customer_id`, `stripe_subscription_id`, `stripe_status`), `discount_codes` / `discount_code_usages`, `user_sessions`, and `webhook_events`. D1 **stores licence tokens because the paywall must verify a purchase from any device the extension is installed on, keyed by the token synced through Chrome storage**, and `webhook_events` exists so Stripe webhook retries are idempotent. `scripts/migrate-d1.sh` documents a consolidation from three legacy per-product D1 databases into this one.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/wrangler.toml "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/d1/schema.sql "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/migrate-d1.sh "source"
    link https://developers.cloudflare.com/d1/ "site"
  }
  chrome_web_store = external_service "Chrome Web Store" {
    technology "Chrome MV3 extension distribution"
    summary "Distribution channel for all five MV3 extensions; landing pages link to store listings and CORS allowlists extension IDs."
    description '''
      Each landing package's `src/config.ts` holds a `chromewebstore.google.com/detail/...` install URL (Gmail is live; sheets/docs/suite/browse are placeholder IDs). `.env.example` defines `ALLOWED_EXTENSION_IDS` for the API's CORS allowlist. The Web Store **is the only delivery path for the product because the paid dark-mode features ship as Chrome MV3 extensions users install from a listing**, which is also why the backend must trust requests originating from `chrome-extension://` IDs rather than a browser origin.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/config.ts "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/.env.example "source"
    link https://chromewebstore.google.com "site"
  }
  google_oauth = external_service "Google OAuth / Sign-In" {
    technology "Google OAuth 2.0 / OpenID Connect ID tokens"
    summary "OIDC identity provider for the account portal; authorization at accounts.google.com with token exchange at oauth2.googleapis.com."
    description '''
      `packages/landing-shared/functions/api/_shared/google-oauth.ts` defines the authorize and token endpoints and validates the ID-token issuer (`accounts.google.com`). Client ID and client secret are Cloudflare secrets listed in `.env.example`; the redirect URI is derived from the request origin at `/api/auth/callback`. Google OAuth **authenticates the account portal because a buyer needs to recover or manage a licence tied to their purchase email without the app storing passwords**, and the verified email is matched against `licenses.email` (indexed via `idx_licenses_email`), with sessions persisted in the D1 `user_sessions` table.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/functions/api/_shared/google-oauth.ts "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/.env.example "source"
    link https://developers.google.com/identity/protocols/oauth2 "site"
  }
  google_workspace_web = external_service "Google Workspace web apps (Gmail/Sheets/Docs/Drive)" {
    technology "Content-script DOM/CSS injection into mail.google.com, docs.google.com, drive.google.com"
    summary "Third-party host pages the content scripts inject into; their unversioned DOM/CSS is the surface every site-* package restyles."
    description '''
      Extension manifests declare `host_permissions` and content-script matches for `https://mail.google.com/*`, with sibling packages targeting `docs.google.com/spreadsheets`, `docs.google.com/document`, and `drive.google.com`. Packages `site-gmail`, `site-sheets`, `site-docs`, and `site-drive` ship per-surface CSS overrides and DOM plugins. These first-party Google web apps **are a hard external dependency because the product's entire value is repainting someone else's shipping UI**, so any Google-side markup change can break the themes — which is what the screenshot harness exists to catch.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/gmail-darkly/static/manifest.json "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-gmail/package.json "source"
    link https://workspace.google.com "site"
  }
  resend = external_service "Resend" {
    technology "Resend HTTP email API"
    summary "Optional transactional email API used for admin notifications; disabled cleanly when no API key is configured."
    description '''
      `packages/landing-shared/functions/api/_shared/email.ts` POSTs to `https://api.resend.com/emails` with a bearer API key, and early-returns when `RESEND_API_KEY` is unset — `.env.example` marks it optional alongside `ADMIN_EMAIL`. Resend **delivers out-of-band notification mail because the operator needs to hear about purchases/licence events without watching the Cloudflare dashboard**, and its optionality keeps local and preview deploys from needing an email vendor at all.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/functions/api/_shared/email.ts "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/.env.example "source"
    link https://resend.com "site"
  }
  stripe = external_service "Stripe" {
    technology "Stripe REST API v1 (no SDK; raw fetch from Workers runtime)"
    summary "Payment processor for checkout sessions, billing portal, coupons/promotion codes, and subscription webhooks across five products x three plans."
    description '''
      `packages/landing-suite/.env.example` enumerates a secret key, a webhook signing secret, 15 price IDs (gmail/sheets/docs/suite/browse x monthly/yearly/lifetime) and 5 product IDs used to scope coupons; all are set as Cloudflare secrets, never committed. Backend code calls the Stripe REST API directly via `fetch` — `https://api.stripe.com/v1/checkout/sessions`, `/v1/billing_portal/sessions`, `/v1/promotion_codes` — from `packages/landing-shared/functions/api/webhook.ts` and the shared stripe helper. Stripe **is the system of record for purchases because the D1 `licenses` row is only created/updated from a signed Stripe webhook after payment succeeds**, and `licenses.stripe_status` mirrors subscription state for cancellations.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/.env.example "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-shared/functions/api/webhook.ts "source"
    link https://stripe.com "site"
  }
  sunrise_sunset_api = external_service "sunrise-sunset.org API" {
    technology "Public JSON REST API"
    summary "Public API queried from the extension to compute local sunrise/sunset times for the automatic sunset-scheduling theme mode."
    description '''
      `packages/core/src/geo/sun-times.ts` sets `API_BASE = 'https://api.sunrise-sunset.org/json'` and fetches it; the extension manifests grant `host_permissions` for `https://api.sunrise-sunset.org/*`. It is called **because the 'sunrise-sunset' theme mode must flip the UI to dark at the user's actual local dusk**, which the background service worker schedules with `chrome.alarms`. A code comment notes only approximate coordinates are sent, and results are cached in `chrome.storage` to avoid repeat calls.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/src/geo/sun-times.ts "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/gmail-darkly/static/manifest.json "source"
    link https://sunrise-sunset.org/api "site"
  }
  inboxsdk = package "InboxSDK" {
    technology "@inboxsdk/core ^2.2.11"
    summary "Third-party Gmail integration SDK (@inboxsdk/core) used to mount Darkly's settings UI inside Gmail's chrome safely."
    description '''
      `@inboxsdk/core` is a runtime dependency of `packages/site-gmail`, `packages/gmail-darkly`, and `packages/darkly-suite`. It is used **because the in-Gmail settings panel must attach to Gmail's own navigation and thread views without hand-parsing obfuscated Gmail DOM**, giving a stable extension point across Gmail releases. Note it loads remote SDK code into the page at runtime, so it also behaves as an external dependency (its docs host appears throughout the vendored bundle), not purely an in-repo library.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/site-gmail/package.json "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/gmail-darkly/package.json "source"
    link https://www.inboxsdk.com "site"
  }
  react = package "React (+ React Router, lucide-react)" {
    technology "React 18 (extensions) / React 19 + react-router-dom 7 (landing)"
    summary "UI runtime for both halves of the stack: React 18 inside the extensions' panels, React 19 with React Router on the landing/account SPAs."
    description '''
      Extensions and `@darkly/core` pin React/ReactDOM ^18.3.1 (peer deps) while every `landing-*` package uses react/react-dom ^19.2.0 with `react-router-dom` ^7 and `lucide-react` icons. React **renders the in-page settings panel and the account portal because both need stateful, re-rendering UI (theme toggles, licence state, checkout flow) rather than static markup**. The deliberate 18/19 split follows the two build systems — webpack for extension bundles, Vite for the SPAs.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/package.json "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/core/package.json "source"
    link https://react.dev "site"
  }
  github_actions = tool "GitHub Actions" {
    technology "GitHub Actions, SHA-pinned third-party actions"
    summary "CI for lint/type-check/test/build and the path-filtered deploy pipeline that ships each landing page to Cloudflare Pages."
    description '''
      `.github/workflows/ci.yml` runs four jobs on ubuntu-latest with `pnpm -r` recursive scripts; `deploy-landing.yml` adds a `detect-changes` job that diffs `HEAD~1..HEAD` and fans out to per-site deploy jobs, treating a `landing-shared` change as a trigger for all of them. Actions **is the deploy control plane because a shared-component edit must republish every landing site at once to avoid version skew across four domains**. All actions are pinned to commit SHAs, `persist-credentials: false` is set on checkout, and Cloudflare credentials are repository secrets.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/ci.yml "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/deploy-landing.yml "source"
    link https://github.com/features/actions "site"
  }
  playwright = tool "Playwright (screenshot harness)" {
    technology "Playwright, sharp, @faker-js/faker"
    summary "Headless browser driving the screenshot-harness pipeline that renders synthetic Workspace-like pages for visual capture."
    description '''
      `packages/screenshot-harness` depends on `playwright` ^1.48 and uses it in `src/pipeline/capture.ts`, alongside `@faker-js/faker` for synthetic content, `sharp` for image processing, and `yaml` for run configs. Playwright **automates capture because store listings and theme regressions need reproducible screenshots of the themed Google surfaces without a human logging into a real Gmail account** — the faker-generated fixture pages stand in for real user data. It is dev-only and never runs in the shipped extension.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/screenshot-harness/package.json "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/screenshot-harness/src/pipeline/capture.ts "source"
    link https://playwright.dev "site"
  }
  pnpm = tool "pnpm workspaces" {
    technology "pnpm 9 workspaces, pnpm-lock.yaml"
    summary "Monorepo package manager linking 19 workspace packages plus build-tools, with pinned overrides for vulnerable transitive deps."
    description '''
      `pnpm-workspace.yaml` globs `packages/*` and `build-tools`; the root `package.json` requires pnpm &gt;= 9, drives everything through `pnpm -r` / `pnpm --filter`, and carries a `pnpm.overrides` block forcing patched versions of handlebars, lodash, serialize-javascript, rollup, ajv, brace-expansion and others. pnpm **is required because packages depend on each other via `workspace:*` (every extension consumes `@darkly/core` and its `site-*` plugin) and CI installs with `--frozen-lockfile` for reproducible builds**.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/pnpm-workspace.yaml "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/package.json "source"
    link https://pnpm.io "site"
  }
  vite = tool "Vite" {
    technology "Vite 7 + @vitejs/plugin-react"
    summary "Build/dev server for the five landing SPAs; emits the dist/ directory that wrangler publishes to Cloudflare Pages."
    description '''
      Every `landing-*` package builds with `tsc -b &amp;&amp; vite build` using `@vitejs/plugin-react` (Vite ^7). Vite **produces the exact `dist` folder the deploy job passes to `pages deploy dist`, so it sits directly on the release path for darklysuite.com and its three sibling domains**. The `dev` scripts read a `FRONTEND_PORT` from a local `.env.clone` file to let parallel clones of the repo run dev servers on non-colliding ports.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/package.json "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-gmail/package.json "source"
    link https://vite.dev "site"
  }
  webpack = tool "webpack" {
    technology "webpack 5, ts-loader, webpack-merge"
    summary "Bundler for all five Chrome MV3 extensions, with separate dev (watch) and prod configs plus copy-webpack-plugin for static assets."
    description '''
      `gmail-darkly`, `sheets-darkly`, `docs-darkly`, `browse-darkly`, and `darkly-suite` each build via `webpack --config webpack.prod.js` and develop via `webpack.dev.js --watch`, using ts-loader, css/style-loader, source-map-loader and copy-webpack-plugin. webpack **is needed rather than Vite because MV3 requires several independent entry points — service worker, content script, page-world script, landing-bridge — emitted as plain files next to a copied `static/manifest.json`**.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/gmail-darkly/package.json "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/darkly-suite/package.json "source"
    link https://webpack.js.org "site"
  }
  wrangler_cli = tool "Wrangler CLI" {
    technology "wrangler (Pages deploy, Workers deploy, D1 execute)"
    summary "Cloudflare CLI used by the deploy action, by the domain-proxy Worker deploys, and by the D1 migration script."
    description '''
      `cloudflare/wrangler-action` invokes `pages deploy` in CI; `scripts/domain-proxies/README.md`/toml files document `npx wrangler deploy --config ...`; `scripts/migrate-d1.sh` requires an authenticated wrangler for D1 export/import and offers a `--dry-run`. Wrangler **is the only path that applies D1 schema changes and binds the DB on deploy, because the licence database and the Pages Functions that read it must be provisioned together or checkout breaks**. `@cloudflare/workers-types` in the landing packages types the same runtime.
    '''
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/scripts/migrate-d1.sh "source"
    link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/.github/workflows/deploy-landing.yml "source"
    link https://developers.cloudflare.com/workers/wrangler/ "site"
  }
  ext_gmail -> core__content_bootstrap "Gmail extension's content entry calls createContentScript with its ProductConfig and the site-gmail plugin. (uses)"
  ext_sheets -> core__content_bootstrap "Sheets extension composes core with site-sheets, including Preserve Grid Colors via renderProductSection. (uses)"
  ext_docs -> core__content_bootstrap "Docs extension composes core with site-docs and sets forceColorSchemeLight to suppress Google's native dark mode. (uses)"
  ext_browse -> core__content_bootstrap "Browse Darkly reuses the same bootstrap for arbitrary sites via the generic site plugin. (uses)"
  ext_suite_bundle -> core__background_worker "Bundle calls createSiteWorker per site and registers one unified message listener instead of five. (uses)"
  core__content_bootstrap -> core__theme_engine "applyMode drives ThemeEngine.apply/applyPreset for all five theme modes. (uses)"
  core__content_bootstrap -> core__inject_kit "Creates the settings modal, mini panel and dashboard FAB, and wires the site plugin's toolbar/sidebar injection. (uses)"
  core__content_bootstrap -> core__payment_client "Resolves Pro status, prices and plan at init and gates the toggle shortcut with gateProAction. (uses)"
  core__content_bootstrap -> core__background_worker "Sends getScheduleStatus and receives schedule-update messages over chrome.runtime messaging. (calls)"
  core__theme_engine -> core__theme_presets "applyPresetVariables writes the selected preset's --darkly-* custom properties onto documentElement. (uses)"
  core__theme_engine -> core__preferences_store "init() loads mode and preset; toggle() persists the new mode. (reads)"
  core__preferences_store -> chrome_sync_storage "Persists mode, preset, schedule and sunrise/sunset config under the product's storageKey for cross-device sync. (writes)"
  core__payment_client -> api_licensing "GET /status/{token}?product=... plus /auth/start and /portal on the Cloudflare Pages Functions backend. (calls)"
  core__payment_client -> chrome_sync_storage "Mints and stores the anonymous UUID licence token under config.tokenKey so identity follows the user's Chrome profile. (writes)"
  core__payment_client -> stripe "Opens checkout and customer-portal tabs that the licensing backend redirects into Stripe. (triggers)"
  core__sun_scheduler -> sunrise_sunset_api "Fetches sunrise/sunset for coordinates rounded to 1 decimal, cached 24h per product. (calls)"
  core__background_worker -> core__sun_scheduler "Brokers offscreen geolocation and resolves the sunrise-sunset mode, falling back to the fixed schedule. (uses)"
  core__background_worker -> core__payment_client "Bootstraps the token on startup, answers getProStatus, and drives the checkout poller. (uses)"
  core__background_worker -> core__preferences_store "Loads prefs to decide alarm scheduling and dark/light resolution, and re-evaluates on change. (reads)"
  core__inject_kit -> core__settings_ui "Mounts SettingsPanel and MiniControlPanel React roots into prefixed containers wrapped in DarklyProvider. (uses)"
  core__settings_ui -> core__preferences_store "Mode, preset and schedule edits save through createPreferencesManager and re-render on change events. (writes)"
  core__settings_ui -> react "React 18 peer dependency plus lucide-react icons for the in-app settings surface. (depends_on)"
  core__theme_presets -> webpack "Canonical darkly- names rely on the build-time CSS prefix loader to become gd-/sd-/dd-/ds-/bd- per extension. (depends_on)"
  core__landing_bridge -> web_darklysuite "Runs on marketing domains, hands the token to the page and forwards its checkout-complete event to the worker. (reads)"
  core__test_suite -> core__conflict_detection "Exercises first-claim-wins ordering across standalone and bundle extension ids on data-darkly-active. (uses)"
  ext__gmail_content -> inboxsdk "gmailPlugin builds the in-Gmail settings sidebar through InboxSDK rather than hand-rolled DOM injection. (uses)"
  ext__gmail_content -> google_workspace_web "Applies the inversion filter and prefixed gd- stylesheets to the live mail.google.com DOM. (writes)"
  ext__gmail_pageworld -> inboxsdk "Web-accessible MAIN-world bundle re-exporting @inboxsdk/core/pageWorld.js so InboxSDK can reach Gmail's page context. (uses)"
  ext__gmail_background -> sunrise_sunset_api "Resolves sunrise/sunset times for the geolocation-driven theme mode using coordinates from the offscreen document. (calls)"
  ext__gmail_background -> api_licensing "Polls /api/status/{token} on darklysuite.com so a Gmail or Suite licence unlocks Pro features. (calls)"
  ext__gmail_background -> chrome_sync_storage "Persists the gd_token UUID identity and gd_preferences so settings and licence follow the signed-in profile. (writes)"
  ext__gmail_build -> webpack "Five-entry webpack build with the darkly- to gd- CSS prefix transform and workspace source aliases. (uses)"
  ext__gmail_build -> chrome_web_store "Produces the packaged 1.0.2 listing, the only Darkly extension currently published. (deploys_to)"
  ext__sheets_content -> google_workspace_web "Injects the toolbar settings button and inversion CSS into docs.google.com/spreadsheets, skipping iframes and print/export. (writes)"
  ext__sheets_background -> api_licensing "Checks sd_token against /api/status/{token}; a Suite licence also satisfies the sheets product query. (calls)"
  ext__sheets_background -> sunrise_sunset_api "Fetches sun times for the sunrise/sunset mode via core's background worker and the offscreen geolocation document. (calls)"
  ext__sheets_build -> webpack "Builds four entries and renames darkly- CSS tokens to sd- to avoid collisions with the ds- bundle. (uses)"
  ext__docs_content -> google_workspace_web "Applies dd- prefixed inversion styles to docs.google.com/document while skipping print, export and preview views. (writes)"
  ext__docs_background -> api_licensing "Resolves Pro entitlement for the docs product from the Cloudflare licensing backend. (calls)"
  ext__docs_build -> webpack "Builds four entries and renames darkly- CSS tokens to dd- for standalone/bundle coexistence. (uses)"
  ext__suite_content_scripts -> google_workspace_web "Four host-scoped scripts theme Gmail, Sheets, Docs and Drive from one listing, each claiming its own ds-site page id. (writes)"
  ext__suite_content_scripts -> inboxsdk "The Gmail content script in the bundle reuses gmailPlugin and its InboxSDK sidebar, backed by the bundle's pageWorld entry. (uses)"
  ext__suite_background -> sunrise_sunset_api "Serves getSunTimes for whichever site the message came from, after validating latitude/longitude ranges. (calls)"
  ext__suite_background -> api_licensing "Single shared worker answers getProStatus for all four sites from one ds_token, implementing the bundle entitlement. (calls)"
  ext__suite_landing_bridge -> ext__suite_background "Requests getToken for checkout binding and forwards checkoutComplete to start the licence poller. (calls)"
  ext__suite_landing_bridge -> web_darklysuite "Listens for darkly-token-request and darkly-checkout-complete CustomEvents dispatched by the marketing site. (reads)"
  ext__browse_background -> chrome_sync_storage "Stores and serves the bd_token UUID, including to landing pages via onMessageExternal for checkout binding. (writes)"
  ext__browse_background -> api_licensing "Payment client and checkout poller resolve Pro status against darklysuite.com/api for the browse product. (calls)"
  ext__browse_sidepanel_ui -> ext__browse_content "Sends bd:getStatus, bd:toggle and bd:setPreset to the active tab so mode and preset changes apply without reload. (calls)"
  ext__browse_page_world -> ext__browse_content "Only shims prefers-color-scheme while the content script has set data-darkly-active on the document element. (depends_on)"
  lmkt__gmail_site_app -> chrome_web_store "Hero/nav/footer CTAs and the CWS badge link to the live Darkly for Gmail listing id in config.ts — the only published listing. (uses)"
  lmkt__gmail_site_app -> api_licensing "buildCheckoutUrl hits darklysuite.com/api/checkout; SubscribePage uses /api/auth/start for restore-purchase sign-in. (uses)"
  lmkt__gmail_site_app -> ext_gmail "useExtensionToken('gmail') reads the existing UUID licence token from the installed extension; useCheckoutComplete hands the licence back after payment. (reads)"
  lmkt__gmail_site_app -> stripe "CSP form-action allows checkout.stripe.com and billing.stripe.com so the centralised Stripe checkout/billing redirect works under default-src 'self'. (uses)"
  lmkt__gmail_site_app -> vite "Built by tsc -b and vite build with @vitejs/plugin-react into dist/ for Cloudflare Pages. (depends_on)"
  lmkt__sheets_site_app -> api_licensing "Checkout and restore-purchase both call darklysuite.com endpoints, keeping payment centralised off the Sheets domain. (uses)"
  lmkt__sheets_site_app -> ext_sheets "useExtensionToken('sheets') reads the chrome.storage.sync token so a purchase binds to the already-installed extension. (reads)"
  lmkt__sheets_site_app -> chrome_web_store "Footer links to a Chrome Web Store URL that still holds PLACEHOLDER_SHEETS_ID pending publication. (uses)"
  lmkt__docs_site_app -> api_licensing "Pricing checkout and restore flows post to darklysuite.com/api/checkout and /api/auth/start. (uses)"
  lmkt__docs_site_app -> ext_docs "useExtensionToken('docs') pulls the existing licence token from the Docs extension before building the checkout URL. (reads)"
  lmkt__docs_site_app -> chrome_web_store "Store link carries PLACEHOLDER_DOCS_ID; nav CTA falls back to on-page pricing until the listing exists. (uses)"
  lmkt__browse_site_app -> api_licensing "Checkout for the browse product routes through the same darklysuite.com licensing API as the Workspace sites. (uses)"
  lmkt__browse_site_app -> ext_browse "useExtensionToken('browse') retrieves the licence token from Browse Darkly (externally_connectable path) before checkout. (reads)"
  lmkt__browse_site_app -> chrome_web_store "Footer store link holds PLACEHOLDER_BROWSE_ID, matching the unpublished state of the Browse listing. (uses)"
  lmkt__browse_site_app -> wrangler_cli "wrangler.toml declares Pages project browse-darkly-landing; with no CI job for this package, wrangler is the only deploy path found. (uses)"
  lmkt__browse_ops_console_routes -> api_licensing "Shared admin licence/discount/stats and account subscription pages call the licensing API and D1-backed endpoints on darklysuite.com. (uses)"
  tool_screenshot_harness -> lmkt__sheets_screenshot_gallery "capture-sheets-landing.mjs resolves landing-sheets/public/images/{screenshots,setup} as its final output directories. (writes)"
  tool_screenshot_harness -> lmkt__docs_screenshot_gallery "capture-docs-landing.mjs writes generated Docs gallery and setup images straight into landing-docs/public/images. (writes)"
  github_actions -> lmkt__gmail_site_app "deploy-landing.yml builds @darkly/landing-gmail and runs pages deploy dist --project-name=gmail-darkly on push or workflow_dispatch. (triggers)"
  github_actions -> lmkt__sheets_site_app "Path-filtered job builds landing-sheets and deploys to Pages project sheets-darkly; a landing-shared change fans out to all sites. (triggers)"
  github_actions -> lmkt__docs_site_app "Path-filtered job builds landing-docs and deploys to Pages project docs-darkly. (triggers)"
  web_gmaildarkly -> cloudflare_pages "Static dist/ published to Cloudflare Pages via wrangler-action, with _headers applying CSP/HSTS at the edge. (deploys_to)"
  web_sheetsdarkly -> cloudflare_pages "sheetsdarkly.com served as its own Pages project so the domain is independently indexable and releasable. (deploys_to)"
  web_docsdarkly -> cloudflare_pages "docsdarkly.com served as its own Pages project built from the shared React component library. (deploys_to)"
  web_browsedarkly -> cloudflare_pages "browsedarkly.com configured as Pages project browse-darkly-landing, serving the general-web-reader marketing surface. (deploys_to)"
  lsh__checkout_fn -> stripe "Creates a Checkout Session with {token, plan, product} metadata and product-specific success/cancel URLs. (calls)"
  lsh__checkout_fn -> lsh__stripe_client "Resolves one of the 15 price ids and issues the Stripe REST call through the shared client. (uses)"

          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/PrivacyPage.tsx#L1-L30 "source"
        }
        lsuite__file_support_page = file "SupportPage.tsx" {
          technology "React"
          summary "Support contact, response-time promise and activation FAQ for paying customers."
          description '''
            Delivers the "Priority email support" feature that appears in every pricing tier in `src/config.ts`, **because** a solo-operator commercial product needs one published support surface for billing and activation problems across all five extensions.

          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-browse/src/config.ts#L1-L102 "source"
        }
        lmkt__browse_delivery_config = file "landing-browse Pages delivery config" {

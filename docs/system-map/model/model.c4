        }
      }
      lsuite__portal_routes = component "Admin and account portal route mounts" {
        technology "react-router-dom nested layout routes"
        summary "Routes that mount the shared AdminLayout/AccountLayout portals onto darklysuite.com; no portal UI is defined locally."
        description '''
          Makes darklysuite.com the operational console as well as the storefront, **because** the brief puts both the Google-OAuth admin portal and the customer account portal on this domain: `/admin` renders `AdminLoginPage` and the authenticated children (`/admin/memberships`, `/admin/discounts`, `/admin/stats`) render `AdminLicensesPage`, `AdminDiscountsPage` and `AdminStatsPage` from `@darkly/landing-shared`, while `/account` + `/account/subscriptions` render `AccountLoginPage` and `AccountSubscriptionsPage`. Every component is imported, not authored here — the hub only supplies the mount points, so the sibling sites can stay marketing-only.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/App.tsx#L31-L40 "source"
      }
      lsuite__product_pages = component "Product marketing pages (Home, Gmail, Sheets, Docs, Suite)" {
        technology "React, @darkly/landing-shared components"
        summary "Per-SKU landing pages composed from shared Hero/Features/Pricing/FAQ components, each wiring its own checkout handler."
        description '''
          The storefront pages for the individual extensions and the bundle, **because** darklysuite.com must present all five SKUs and drive the bundle upsell: `HomePage` renders four `ProductCard`s that scroll into a comparison `Pricing` table where the Suite column ticks every feature row the individual products leave blank (`COMPARISON_FEATURES` in `src/config.ts`), making the "a Suite licence satisfies any individual product" story visible before purchase.
          
          Every page follows the same pattern: `useExtensionToken(product)` picks up an already-installed extension's UUID token, `getOrCreateToken(null, extensionToken)` mints one if absent, and `buildCheckoutUrl(CHECKOUT_API_URL, product, plan, token)` redirects the browser to `/api/checkout` — which is why no account is needed to buy. `HomePage` and `GmailPage` also embed hero/feature screenshots from `public/images/screenshots/`.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/HomePage.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SuitePage.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/GmailPage.tsx "source"
        lsuite__file_docs_page = file "DocsPage.tsx" {
          technology "React"
          summary "Darkly for Docs SKU page covering canvas rendering and document styling."
          description '''

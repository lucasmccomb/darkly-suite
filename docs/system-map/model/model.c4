          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SheetsPage.tsx "source"
        }
        lsuite__file_suite_page = file "SuitePage.tsx" {
          technology "React"
          summary "Bundle SKU page selling one licence covering Gmail, Sheets, Docs and Drive."
          description '''
            Carries the bundle upsell **because** it is the page that states the Suite value proposition ("One extension, one license") that the licence backend implements by letting a Suite licence satisfy a status query for any individual product; it passes both `individualTiers` and `bundleTiers` into the shared `Pricing` component so the price gap is explicit.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/SuitePage.tsx#L16-L42 "source"
        }
      }
      lsuite__site_config = component "Hub site config: pricing tiers, store URLs, navigation" {
        technology "TypeScript module, shared PricingTier/ComparisonFeature types"
        summary "Single module defining the 3-plan tier sets for individual products and the bundle, Chrome Web Store links, nav/footer, and API paths."
        description '''
          The catalogue the whole storefront reads from, **because** the 5-products x 3-plans price matrix in the brief has to appear as UI somewhere: `individualTiers(product)` yields Monthly $0.99 / Yearly $5.99 / Lifetime $9.99 and `bundleTiers` yields $1.99 / $9.99 / $19.99, and `COMPARISON_FEATURES` encodes the bundle upsell as a feature matrix where only the suite column covers Drive dark mode. It also pins `CHECKOUT_API_URL = '/api/checkout'` and `AUTH_API_URL = '/api/auth/start'` — the same-origin Pages Functions endpoints permitted by the CSP — plus `STORE_URLS` (Gmail has a real Chrome Web Store id; sheets/docs/suite are still `PLACEHOLDER_*` strings) and the nav/footer link sets that expose `/account` on every page.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/config.ts#L1-L126 "source"
      }
      lsuite__spa_shell = component "SPA shell, router and security headers" {
        technology "React 19, react-router-dom 7, Vite 7, TypeScript"
        summary "Vite+React 19 entry point, BrowserRouter route table for all darklysuite.com pages, and the Cloudflare Pages _headers CSP."
        description '''
          The React SPA shell that makes darklysuite.com the single storefront for all five SKUs, **because** every commercial surface named in the brief (Home, Suite, Gmail, Sheets, Docs, Subscribe, Success, Setup, Support, Privacy plus the admin and account portals) is mounted as one `react-router-dom` route table in `src/App.tsx`, so a buyer can move from a product page to checkout to setup without leaving the hub.
          
          - `src/main.tsx` mounts `App` into `#root` and imports the shared `globals.css` / `admin.css` from `@darkly/landing-shared`, so the hub and the marketing-only sibling sites render from one design system.
          - `src/App.tsx` wraps everything in `BrowserRouter` + shared `ScrollToHash` (needed because pricing CTAs link to `/#pricing`).
          - `public/_headers` ships a strict CSP: `script-src 'self'`, `connect-src 'self'`, `frame-src 'none'`, and `form-action` allowlisting only `checkout.stripe.com` and `billing.stripe.com` — i.e. the only cross-origin POST targets are the Stripe Checkout and Billing Portal redirects the purchase flow needs.
          - `vite.config.ts` is a bare `@vitejs/plugin-react` config; `package.json` builds with `tsc -b &amp;&amp; vite build` into `dist/`, which `wrangler.toml` declares as `pages_build_output_dir`.
        '''
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/App.tsx#L1-L44 "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/main.tsx "source"
        link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/index.html "source"
        lsuite__file_app_tsx = file "App.tsx route table" {
          technology "react-router-dom"
          summary "Single route table binding 10 marketing/commerce pages plus admin and account portal routes imported from landing-shared."
          description '''
            Declares every public path on darklysuite.com **because** the hub must serve product pages for all five SKUs *and* host the licence-authority UIs: `/`, `/gmail`, `/sheets`, `/docs`, `/suite`, `/privacy`, `/success`, `/setup`, `/subscribe`, `/support`, then `/admin` + `/admin/{memberships,discounts,stats}` under the shared `AdminLayout`, and `/account` + `/account/subscriptions` under `AccountLayout`. Notably there is no `/browse` route even though Browse Darkly is the fifth SKU.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/App.tsx#L16-L44 "source"
        }
        lsuite__file_headers = file "_headers (CSP + transport security)" {
          technology "Cloudflare Pages _headers"
          summary "Cloudflare Pages header rules: CSP, HSTS, X-Frame-Options DENY, nosniff, referrer and permissions policy."
          description '''
            Hardens the storefront **because** darklysuite.com is the licence authority and payment entry point for all five products: `form-action` permits only Stripe Checkout/Billing Portal, `frame-ancestors 'none'` blocks clickjacking of the account and admin portals, and `connect-src 'self'` keeps SPA fetches on the same origin as the Pages Functions API.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/public/_headers#L1-L7 "source"
        }
        lsuite__file_main_tsx = file "main.tsx entry" {
          technology "React 19 createRoot"
          summary "React root creation plus imports of shared global and admin stylesheets from @darkly/landing-shared."
          description '''
            Bootstraps the hub SPA **because** the shared stylesheet imports are what keep darklysuite.com visually identical to the marketing-only sibling sites that funnel buyers here for checkout.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/main.tsx#L1-L11 "source"
        }
      }
    }
    web_docsdarkly = container "docsdarkly.com (Docs marketing site)" {
      technology "Vite 7, React 19, Cloudflare Pages"
      summary "Static Vite + React 19 marketing site for the Docs extension, deployed to Cloudflare Pages project docs-darkly."

          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/GmailPage.tsx#L28-L54 "source"
        }
        lsuite__file_home_page = file "HomePage.tsx" {
          technology "React"
          summary "Hub landing page: four product cards, feature section, comparison pricing table, FAQ, and the checkout redirect handler."
          description '''
            Top of the commercial funnel **because** it is the page all five product stories converge on: selecting Gmail/Sheets/Docs scrolls to the pricing comparison with that app preselected, and `handleCheckout` resolves the chrome.storage UUID token before redirecting to `/api/checkout`, so a purchase made here binds to the extension the visitor already has installed.
          '''
          link https://github.com/lucasmccomb/darkly-suite/blob/8816bd58e92a79f97dace48e5bd70955bf49b111/packages/landing-suite/src/pages/HomePage.tsx#L19-L33 "source"
        }
        lsuite__file_sheets_page = file "SheetsPage.tsx" {
          technology "React"
          summary "Darkly for Sheets SKU page emphasising grid/formula-bar aware styling."

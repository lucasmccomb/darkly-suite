{
  "manifest_version": 3,
  "name": "Darkly Suite",
  "description": "Dark mode for Gmail, Sheets, Docs, and Drive with OS theme sync, sunset scheduling, and unified settings. One extension, four Google apps.",
  "version": "1.0.0",
  "permissions": ["storage", "alarms", "offscreen", "scripting"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://docs.google.com/spreadsheets/*",
    "https://docs.google.com/document/*",
    "https://drive.google.com/*",
    "https://darklysuite.com/*",
    "https://api.sunrise-sunset.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content-gmail.js"],
      "css": ["styles/themes.css", "styles/gmail-overrides.css", "styles/settings-panel.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["content-sheets.js"],
      "css": ["styles/themes.css", "styles/sheets-overrides.css", "styles/settings-panel.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content-docs.js"],
      "css": ["styles/themes.css", "styles/docs-overrides.css", "styles/settings-panel.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["content-drive.js"],
      "css": ["styles/themes.css", "styles/drive-overrides.css", "styles/settings-panel.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageWorld.js", "icons/*"],
      "matches": [
        "https://mail.google.com/*",
        "https://docs.google.com/*",
        "https://drive.google.com/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": ["https://darklysuite.com/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

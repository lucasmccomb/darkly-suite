# Cloudflare Pages env vars for darklysuite.com landing + payment backend
# Set these as production secrets in the Cloudflare Pages dashboard.
# For local development, copy to .dev.vars (which is gitignored).

# Stripe (live mode in production, test mode in dev)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Stripe price IDs (one per product x plan, 15 total)
# Set these as production secrets — sandbox values can live in .dev.vars
STRIPE_PRICE_GMAIL_MONTHLY=price_xxx
STRIPE_PRICE_GMAIL_YEARLY=price_xxx
STRIPE_PRICE_GMAIL_LIFETIME=price_xxx
STRIPE_PRICE_SHEETS_MONTHLY=price_xxx
STRIPE_PRICE_SHEETS_YEARLY=price_xxx
STRIPE_PRICE_SHEETS_LIFETIME=price_xxx
STRIPE_PRICE_DOCS_MONTHLY=price_xxx
STRIPE_PRICE_DOCS_YEARLY=price_xxx
STRIPE_PRICE_DOCS_LIFETIME=price_xxx
STRIPE_PRICE_SUITE_MONTHLY=price_xxx
STRIPE_PRICE_SUITE_YEARLY=price_xxx
STRIPE_PRICE_SUITE_LIFETIME=price_xxx
STRIPE_PRICE_BROWSE_MONTHLY=price_xxx
STRIPE_PRICE_BROWSE_YEARLY=price_xxx
STRIPE_PRICE_BROWSE_LIFETIME=price_xxx

# Stripe product IDs (used for coupon applies_to restriction)
STRIPE_PRODUCT_GMAIL=prod_xxx
STRIPE_PRODUCT_SHEETS=prod_xxx
STRIPE_PRODUCT_DOCS=prod_xxx
STRIPE_PRODUCT_SUITE=prod_xxx
STRIPE_PRODUCT_BROWSE=prod_xxx

# Google OAuth (account portal sign-in)
# Redirect URI is derived from the request origin at runtime (/api/auth/callback)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# Admin
ADMIN_EMAIL=admin@example.com

# Optional: Resend (for admin email notifications)
RESEND_API_KEY=

# Allowed extension IDs (comma-separated). Required in production for CORS.
ALLOWED_EXTENSION_IDS=kfgkinaheobhehhcaobkehpgghipeife,...

# Environment
ENVIRONMENT=production

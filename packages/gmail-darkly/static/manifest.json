{
  "manifest_version": 3,
  "name": "Darkly for Gmail\u2122",
  "description": "Dark mode for Gmail with OS theme sync, sunset scheduling, and schedule mode. Settings right inside Gmail.",
  "version": "1.0.0",
  "permissions": ["storage", "alarms", "offscreen", "scripting", "identity", "identity.email"],
  "host_permissions": ["https://mail.google.com/*", "https://darklysuite.com/*", "https://api.sunrise-sunset.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "css": [
        "styles/themes.css",
        "styles/gmail-overrides.css",
        "styles/settings-panel.css"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageWorld.js", "pageWorld.js.map", "icons/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

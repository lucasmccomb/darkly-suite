{
  "name": "@darkly/landing-docs",
  "version": "1.0.0",
  "description": "Marketing landing page for docsdarkly.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "FPORT=$(grep FRONTEND_PORT ../../.env.clone 2>/dev/null | cut -d= -f2) && vite --port ${FPORT:-5285}",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@darkly/landing-shared": "workspace:*",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}

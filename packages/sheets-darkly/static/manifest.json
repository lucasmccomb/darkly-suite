{
  "manifest_version": 3,
  "name": "Darkly for Google Sheets\u2122",
  "description": "Dark mode for Google Sheets with OS theme sync, sunset scheduling, and color presets. Settings right inside Sheets.",
  "version": "1.0.0",
  "permissions": ["storage", "alarms", "offscreen"],
  "host_permissions": ["https://docs.google.com/*", "https://darklysuite.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "css": [
        "styles/themes.css",
        "styles/sheets-overrides.css",
        "styles/night-tint.css",
        "styles/settings-panel.css"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://docs.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

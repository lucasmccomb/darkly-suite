{
  "manifest_version": 3,
  "name": "Browse Darkly",
  "description": "Dark mode for every website — beautiful presets, per-site memory, and smart detection",
  "version": "1.0.0",
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "alarms"],
  "host_permissions": ["<all_urls>", "https://darklysuite.com/*", "https://api.sunrise-sunset.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "externally_connectable": {
    "matches": ["https://darklysuite.com/*", "https://browsedarkly.com/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
